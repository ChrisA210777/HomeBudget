<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AspNetCoreVersion>10.0.14</AspNetCoreVersion>
    <EfCoreVersion>10.0.14</EfCoreVersion>
  </PropertyGroup>
  <ItemGroup Label="Transitive security pins">
    <!-- bUnit pulls in AngleSharp 1.1.2, which is affected by GHSA-pgww-w46g-26qg; fixed in 1.5.0. -->
    <PackageVersion Include="AngleSharp" Version="1.5.0" />
    <!-- Microsoft.Data.SqlClient (via EF Core SqlServer) pulls in Pkcs 9.0.11, which is affected by
         GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. Use the current .NET 10 servicing release. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="ASP.NET Core / Blazor">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>
  <ItemGroup Label="Data access and Identity">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="bunit" Version="1.36.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>
</Project>
