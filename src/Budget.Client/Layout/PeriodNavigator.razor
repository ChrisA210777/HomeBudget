@* Previous, the period's name, "Go to today" and next (BUD-124, BUD-130). Where the page offers more than one length
   of period, the name opens a menu of them, e.g. a week or a month (BUD-135), instead of a separate toggle.
   "Go to today" floats beside the next arrow, so the name doesn't move when it appears: the name stays centred while
   it fits, and only a long one moves left to keep clear of the icon (see the .razor.css). *@

<div class="period-navigator @(IsCurrent ? null : "has-today") @Class">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="@PreviousLabel" OnClick="OnPrevious" data-testid="@PreviousTestId" />
    <div class="period-name mud-typography mud-typography-h6 @(Choices is { Count: > 1 } ? "period-choice" : null)" data-testid="@NameTestId">
        @if (Choices is { Count: > 1 })
        {
            <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                               aria-label="@($"Change period, {Name}")" aria-haspopup="menu">
                        <span class="period-text">@Name</span>
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudText Typo="Typo.overline" Class="px-4 pt-2">Show</MudText>
                    @foreach (var choice in Choices)
                    {
                        <MudMenuItem Icon="@(choice.Selected ? Icons.Material.Filled.Check : null)" OnClick="() => choice.Choose.InvokeAsync()" data-testid="@choice.TestId">@choice.Name</MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <span class="period-text">@Name</span>
        }
    </div>
    @if (!IsCurrent)
    {
        @* Floats beside the next arrow, so the name stays where it is when it appears (BUD-135). *@
        <div class="period-today">
            <MudTooltip Text="@TodayLabel">
                <MudIconButton Icon="@Icons.Material.Filled.Today" Color="Color.Primary" aria-label="@TodayLabel" OnClick="OnToday" data-testid="go-to-today" />
            </MudTooltip>
        </div>
    }
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="@NextLabel" OnClick="OnNext" data-testid="@NextTestId" />
</div>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Extra classes, e.g. for spacing.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Whether today is in the period shown; if not, "Go to today" is offered.</summary>
    [Parameter]
    public bool IsCurrent { get; set; }

    [Parameter]
    public string PreviousLabel { get; set; } = "Previous month";

    [Parameter]
    public string NextLabel { get; set; } = "Next month";

    [Parameter]
    public string TodayLabel { get; set; } = "Go to today";

    [Parameter]
    public EventCallback OnPrevious { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback OnToday { get; set; }

    [Parameter]
    public string PreviousTestId { get; set; } = "previous-period";

    [Parameter]
    public string NextTestId { get; set; } = "next-period";

    [Parameter]
    public string NameTestId { get; set; } = "period-name";

    /// <summary>The lengths of period the page offers, e.g. a week or a month; with two or more, the name opens them as a menu.</summary>
    [Parameter]
    public IReadOnlyList<PeriodChoice>? Choices { get; set; }
}
