@* The signed-in user's name with a menu holding "Sign out". Shown in the app bar on every screen size. *@
@inject IAccountApi AccountApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<AuthorizeView>
    <Authorized>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.AccountCircle"
                           Class="user-menu-button"
                           aria-label="Account menu"
                           data-testid="user-menu-button">
                    <span class="user-menu-name">@context.User.Identity?.Name</span>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                             OnClick="SignOutAsync"
                             Disabled="_signingOut"
                             data-testid="sign-out">
                    Sign out
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </Authorized>
</AuthorizeView>

@code {
    private bool _signingOut;

    private async Task SignOutAsync()
    {
        _signingOut = true;
        try
        {
            await AccountApi.SignOutAsync();
        }
        catch (HttpRequestException)
        {
            _signingOut = false;
            Snackbar.Add("Couldn't sign out. Check your connection and try again.", Severity.Error);
            return;
        }

        // A full page load throws away everything the app had loaded for this user.
        Navigation.NavigateTo(AccountRoutes.LoginPageAfterSignOut, forceLoad: true);
    }
}
