@* The signed-in user's name with a menu holding the theme choice and "Sign out". Shown in the app bar on every screen size. *@
@inject IAccountApi AccountApi
@inject ThemePreference ThemePreference
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<AuthorizeView>
    <Authorized Context="auth">
        @* MudBlazor's own button activator: wrapping a button in ActivatorContent nests one control in another. *@
        <MudMenu AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 Label="@auth.User.Identity?.Name"
                 StartIcon="@Icons.Material.Filled.AccountCircle"
                 Variant="Variant.Text"
                 Color="Color.Inherit"
                 AriaLabel="@($"Account menu for {auth.User.Identity?.Name}")"
                 Class="user-menu"
                 data-testid="user-menu">
            <ChildContent>
                <MudText Typo="Typo.overline" Class="px-4 pt-2" id="theme-heading">Theme</MudText>
                @foreach (var option in ThemeOptions)
                {
                    <MudMenuItem Icon="@(ThemePreference.Mode == option.Mode ? Icons.Material.Filled.Check : option.Icon)"
                                 OnClick="() => ThemePreference.SetAsync(option.Mode)"
                                 data-selected="@(ThemePreference.Mode == option.Mode ? "true" : "false")"
                                 data-testid="@($"theme-{option.Mode.ToString().ToLowerInvariant()}")">
                        @option.Label
                        @if (ThemePreference.Mode == option.Mode)
                        {
                            <span class="visually-hidden"> (selected)</span>
                        }
                    </MudMenuItem>
                }
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                             OnClick="SignOutAsync"
                             Disabled="_signingOut"
                             data-testid="sign-out">
                    Sign out
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </Authorized>
</AuthorizeView>

@code {
    private static readonly (ThemeMode Mode, string Label, string Icon)[] ThemeOptions =
    [
        (ThemeMode.System, "Use device setting", Icons.Material.Filled.SettingsBrightness),
        (ThemeMode.Light, "Light", Icons.Material.Filled.LightMode),
        (ThemeMode.Dark, "Dark", Icons.Material.Filled.DarkMode),
    ];

    private bool _signingOut;

    private async Task SignOutAsync()
    {
        _signingOut = true;
        try
        {
            await AccountApi.SignOutAsync();
        }
        catch (HttpRequestException)
        {
            _signingOut = false;
            Snackbar.Add("Couldn't sign out. Check your connection and try again.", Severity.Error);
            return;
        }

        // A full page load throws away everything the app had loaded for this user.
        Navigation.NavigateTo(AccountRoutes.LoginPageAfterSignOut, forceLoad: true);
    }
}
