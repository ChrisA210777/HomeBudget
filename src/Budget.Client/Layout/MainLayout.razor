@inherits LayoutComponentBase

@* Placeholder shell. The responsive navigation, household switcher and user menu arrive in BUD-36. *@

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6" Class="mr-4">Home Budget</MudLink>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/income" Color="Color.Inherit" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Payments" aria-label="Income">
                    <span class="d-none d-sm-inline">Income</span>
                </MudButton>
                <MudButton Href="/people" Color="Color.Inherit" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.People" aria-label="People">
                    <span class="d-none d-sm-inline">People</span>
                </MudButton>
            </Authorized>
        </AuthorizeView>
        <MudSpacer />
        <UserMenu />
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
