@inherits LayoutComponentBase

@* Placeholder shell. The responsive navigation, household switcher and user menu arrive in BUD-36. *@

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Home Budget</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" data-testid="signed-in-user">@context.User.Identity?.Name</MudText>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
