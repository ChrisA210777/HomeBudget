@page "/people"
@attribute [Authorize]
@using Budget.Client.People
@using Budget.Shared.People
@inject UserSession Session
@inject IPeopleApi PeopleApi
@inject ISnackbar Snackbar

<PageTitle>People · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4 mb-16">
    <h1 class="mud-typography mud-typography-h4 mb-2">People</h1>
    <MudText Typo="Typo.body2" Class="mb-4">
        Everyone whose income or bills you track. They don't need to sign in, but they can be linked to their login when they join.
    </MudText>
    <MudButton Href="/members" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ManageAccounts" Class="mb-4" data-testid="go-to-members">Who can sign in: members and roles</MudButton>

    @if (_people is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Outlined="true">
            @* A plain list: MudList is a selectable list box, which can't contain buttons. *@
            <ul class="plain-list" aria-label="People in this household">
                @foreach (var person in _people)
                {
                    <li class="plain-list-item" data-testid="person">
                        @if (_editingId == person.Id)
                        {
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudTextField @bind-Value="_editName"
                                              Label="Name"
                                              MaxLength="PersonValidator.DisplayNameMaxLength"
                                              Error="_editError is not null"
                                              ErrorText="@_editError"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="flex-grow-1"
                                              data-testid="rename-name" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveRenameAsync(person)" Disabled="!Online" data-testid="rename-save">Save</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="CancelRename">Cancel</MudButton>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" />
                                <div class="flex-grow-1" style="min-width: 0">
                                    <MudText Typo="Typo.body1" data-testid="person-name">@person.DisplayName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="person-login">@LoginDescription(person)</MudText>
                                </div>
                                @if (person.IsYou)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">You</MudChip>
                                }
                                @if (_canEdit)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="@($"Rename {person.DisplayName}")" OnClick="() => StartRename(person)" data-testid="rename" />
                                }
                                @if (_isAdmin && person.LinkedUserId is null)
                                {
                                    <MudTooltip Text="@($"Remove {person.DisplayName}")">
                                        <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Color="Color.Error" aria-label="@($"Remove {person.DisplayName}")"
                                                       OnClick="() => StartRemoveAsync(person)" Disabled="!Online" data-testid="remove-person" />
                                    </MudTooltip>
                                }
                            </div>

                            @if (_removingId == person.Id && _removal is not null)
                            {
                                @* BUD-112, ADR-016: what happens to their items is chosen before they're removed. *@
                                <div class="mt-3 pa-3 confirm-panel" role="group" aria-label="@($"Remove {person.DisplayName}")" data-testid="remove-person-panel">
                                    <MudText Typo="Typo.body2" Class="mb-3">
                                        Remove @person.DisplayName from the household's people? Their name goes from the household, and this can't be undone.
                                    </MudText>
                                    @if (_removal.IncomeCount > 0)
                                    {
                                        <MudSelect T="string" @bind-Value="_incomeChoice" Label="@($"Their income ({_removal.IncomeCount})")" Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" Class="mb-3" data-testid="remove-income">
                                            @foreach (var other in Others(person))
                                            {
                                                <MudSelectItem T="string" Value="@other.Id.ToString()">Move to @other.DisplayName</MudSelectItem>
                                            }
                                            <MudSelectItem T="string" Value="@RemovalChoices.Delete">Delete it</MudSelectItem>
                                        </MudSelect>
                                    }
                                    @if (_removal.OutgoingCount > 0)
                                    {
                                        <MudSelect T="string" @bind-Value="_outgoingsChoice" Label="@($"Their outgoings ({_removal.OutgoingCount})")" Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" Class="mb-3" data-testid="remove-outgoings">
                                            <MudSelectItem T="string" Value="@RemovalChoices.Household">Make them the household's</MudSelectItem>
                                            @foreach (var other in Others(person))
                                            {
                                                <MudSelectItem T="string" Value="@other.Id.ToString()">Move to @other.DisplayName</MudSelectItem>
                                            }
                                            <MudSelectItem T="string" Value="@RemovalChoices.Delete">Delete them</MudSelectItem>
                                        </MudSelect>
                                    }
                                    @if (_removal.AccountCount > 0)
                                    {
                                        <MudSelect T="bool" @bind-Value="_archiveAccounts" Label="@($"Their accounts ({_removal.AccountCount})")" Variant="Variant.Outlined"
                                                   Margin="Margin.Dense" Class="mb-3" data-testid="remove-accounts">
                                            <MudSelectItem T="bool" Value="false">Make them the household's</MudSelectItem>
                                            <MudSelectItem T="bool" Value="true">Make them the household's, and archive them</MudSelectItem>
                                        </MudSelect>
                                    }
                                    @if (_removeError is not null)
                                    {
                                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="remove-person-error">@_removeError</MudAlert>
                                    }
                                    <div class="d-flex gap-2 flex-wrap">
                                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => RemoveAsync(person)" Disabled="@(_saving || !Online)"
                                                   data-testid="remove-person-yes">Remove</MudButton>
                                        <MudButton Variant="Variant.Text" OnClick="CancelRemove" data-testid="remove-person-cancel">Cancel</MudButton>
                                    </div>
                                </div>
                            }
                        }
                    </li>
                }
            </ul>
        </MudPaper>

        @if (_canEdit)
        {
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Add someone</MudText>
                <div class="d-flex align-start gap-2 flex-wrap">
                    <MudTextField @bind-Value="_newName"
                                  Label="Name"
                                  HelperText="For example, a partner or a child with a part-time job"
                                  MaxLength="PersonValidator.DisplayNameMaxLength"
                                  Error="_addError is not null"
                                  ErrorText="@_addError"
                                  Variant="Variant.Outlined"
                                  Class="flex-grow-1"
                                  data-testid="add-name" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddAsync" Disabled="@(_saving || !Online)" Class="mt-2" data-testid="add-person">Add</MudButton>
                </div>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    /// <summary>False while the device is offline, when changes can't be saved (BUD-38).</summary>
    [CascadingParameter(Name = "Online")]
    public bool Online { get; set; } = true;

    private HouseholdMembershipSummary? _household;
    private IReadOnlyList<PersonSummary>? _people;
    private bool _canEdit;
    private bool _isAdmin;

    private Guid? _removingId;
    private PersonRemovalCheck? _removal;
    private string? _incomeChoice;
    private string? _outgoingsChoice;
    private bool _archiveAccounts;
    private string? _removeError;
    private bool _saving;

    private string? _newName;
    private string? _addError;

    private Guid? _editingId;
    private string? _editName;
    private string? _editError;

    protected override async Task OnInitializedAsync()
    {
        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        _isAdmin = _household?.Role == "Admin";
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _people = _household is null ? [] : await PeopleApi.ListAsync(_household.HouseholdId);

    private static string LoginDescription(PersonSummary person) =>
        person.LinkedUserId is null ? "Doesn't sign in" : $"Signs in as {person.LinkedUserName}";

    private async Task AddAsync()
    {
        var request = new SavePersonRequest { DisplayName = _newName ?? string.Empty };
        _addError = FirstError(PersonValidator.Validate(request));
        if (_addError is not null)
        {
            return;
        }

        _saving = true;
        try
        {
            var result = await PeopleApi.AddAsync(_household!.HouseholdId, request);
            if (!result.Succeeded)
            {
                _addError = FirstError(result.Errors);
                return;
            }

            Snackbar.Add($"{result.Saved!.DisplayName} was added.", Severity.Success);
            _newName = null;
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartRename(PersonSummary person)
    {
        _editingId = person.Id;
        _editName = person.DisplayName;
        _editError = null;
    }

    private void CancelRename() => _editingId = null;

    private async Task SaveRenameAsync(PersonSummary person)
    {
        var request = new SavePersonRequest { DisplayName = _editName ?? string.Empty };
        _editError = FirstError(PersonValidator.Validate(request));
        if (_editError is not null)
        {
            return;
        }

        var result = await PeopleApi.RenameAsync(_household!.HouseholdId, person.Id, request);
        if (!result.Succeeded)
        {
            _editError = FirstError(result.Errors);
            return;
        }

        _editingId = null;
        if (person.IsYou)
        {
            // The app bar shows your own person's name.
            await Session.SetPersonNameAsync(_household.HouseholdId, result.Saved!.DisplayName);
        }

        await LoadAsync();
    }

    private static string? FirstError(IReadOnlyDictionary<string, string[]> errors) =>
        errors.Values.SelectMany(v => v).FirstOrDefault();

    private IEnumerable<PersonSummary> Others(PersonSummary person) => (_people ?? []).Where(p => p.Id != person.Id);

    private async Task StartRemoveAsync(PersonSummary person)
    {
        _removeError = null;
        _removal = await PeopleApi.CheckRemovalAsync(_household!.HouseholdId, person.Id);
        _removingId = person.Id;

        // Income always belongs to someone: move it to the first other person unless there's no one.
        _incomeChoice = Others(person).FirstOrDefault()?.Id.ToString() ?? RemovalChoices.Delete;
        _outgoingsChoice = RemovalChoices.Household;
        _archiveAccounts = false;
    }

    private void CancelRemove()
    {
        _removingId = null;
        _removal = null;
    }

    private async Task RemoveAsync(PersonSummary person)
    {
        var request = new RemovePersonRequest
        {
            Income = _incomeChoice == RemovalChoices.Delete ? RemovalChoices.Delete : RemovalChoices.Person,
            IncomeTo = Guid.TryParse(_incomeChoice, out var incomeTo) ? incomeTo : null,
            Outgoings = Guid.TryParse(_outgoingsChoice, out _) ? RemovalChoices.Person : _outgoingsChoice,
            OutgoingsTo = Guid.TryParse(_outgoingsChoice, out var outgoingsTo) ? outgoingsTo : null,
            ArchiveAccounts = _archiveAccounts,
        };

        _saving = true;
        try
        {
            _removeError = await PeopleApi.RemoveAsync(_household!.HouseholdId, person.Id, request);
            if (_removeError is null)
            {
                Snackbar.Add($"{person.DisplayName} was removed.", Severity.Success);
                CancelRemove();
                await LoadAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
