@page "/members"
@attribute [Authorize]
@using Budget.Client.Households
@using Budget.Shared.Households
@inject UserSession Session
@inject IHouseholdApi HouseholdApi
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Members · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4 mb-16">
    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.People" Href="/people" Class="mb-2" data-testid="go-to-people">People</MudButton>
    <h1 class="mud-typography mud-typography-h4 mb-2">Members</h1>
    <MudText Typo="Typo.body2" Class="mb-4">
        Everyone who can sign in to @(_household?.Name ?? "this household"), and what they can do.
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null" data-testid="member-error">@_error</MudAlert>
    }

    @if (_members is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Outlined="true">
            <ul class="plain-list" aria-label="Members of this household">
                @foreach (var member in _members)
                {
                    var isYou = member.UserId == _userId;
                    <li class="plain-list-item" data-testid="member">
                        <div class="d-flex align-start gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Secondary" Class="mt-1" aria-hidden="true" />
                            <div class="flex-grow-1" style="min-width: 0">
                                <div class="d-flex align-center flex-wrap gap-1">
                                    <MudText Typo="Typo.body1" data-testid="member-name">@member.DisplayName</MudText>
                                    @if (isYou)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ma-0" data-testid="member-you">You</MudChip>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(member.Email))
                                {
                                    <MudText Typo="Typo.body2" Class="text-break" data-testid="member-email">@member.Email</MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="member-joined">Joined @TimeZoneInfo.ConvertTime(member.JoinedAt, Clock.LocalTimeZone).ToString("d MMM yyyy")</MudText>
                            </div>
                            <div class="d-flex flex-column align-end gap-1">
                                <MudChip T="string" Size="Size.Small" Color="RoleColor(member.Role)" Class="ma-0" data-testid="member-role">@member.Role</MudChip>
                                @if (member.IsOwner)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Star" Class="ma-0" data-testid="member-owner">Owner</MudChip>
                                }
                            </div>
                        </div>

                        @if (_isAdmin && !member.IsOwner)
                        {
                            @if (_removingId == member.UserId)
                            {
                                <div class="mt-3 pa-3 confirm-panel" role="group" aria-label="@($"Remove {member.DisplayName}")" data-testid="remove-confirm">
                                    <MudText Typo="Typo.body2" Class="mb-2">
                                        @(isYou ? "Remove yourself from this household?" : $"Remove {member.DisplayName} from this household?")
                                        They'll lose access straight away. Any person linked to their login stays, with their income and outgoings.
                                    </MudText>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => RemoveAsync(member)" Disabled="@(_saving || !Online)" data-testid="remove-yes">Remove</MudButton>
                                        <MudButton Variant="Variant.Text" OnClick="() => _removingId = null" data-testid="remove-cancel">Cancel</MudButton>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-center gap-2 mt-2 flex-wrap">
                                    <div style="width: 9rem">
                                        <MudSelect T="string" Value="member.Role" ValueChanged="role => ChangeRoleAsync(member, role)" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   Disabled="@(_saving || !Online)" data-testid="role-select">
                                            @foreach (var role in MemberRoles.All)
                                            {
                                                <MudSelectItem T="string" Value="role">@role</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.PersonRemove" OnClick="() => _removingId = member.UserId"
                                               Disabled="!Online" aria-label="@($"Remove {member.DisplayName}")" data-testid="remove-member">Remove</MudButton>
                                </div>
                            }
                        }
                    </li>
                }
            </ul>
        </MudPaper>

        @if (_isAdmin && _household is not null)
        {
            <InvitationsPanel HouseholdId="_household.HouseholdId" HouseholdName="@_household.Name" />
        }

        @if (_household is not null)
        {
            <MudPaper Outlined="true" Class="pa-4 mt-4" data-testid="leave-section">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Leave this household</MudText>
                @if (_household.IsOwner)
                {
                    <MudText Typo="Typo.body2" data-testid="owner-cant-leave">
                        As the owner, you can't leave. Handing ownership to someone else is coming later; until then you can delete the household instead.
                    </MudText>
                }
                else if (_confirmLeave)
                {
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Leave @_household.Name? You'll lose access straight away, and an Admin would need to invite you again.
                    </MudText>
                    <div class="d-flex gap-2 flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="LeaveAsync" Disabled="@(_saving || !Online)" data-testid="leave-yes">Leave</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="() => _confirmLeave = false" data-testid="leave-cancel">Cancel</MudButton>
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-2">You'll stop seeing this household's budget.</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="() => _confirmLeave = true" Disabled="!Online" data-testid="leave">Leave household</MudButton>
                }
            </MudPaper>

            @if (_household.IsOwner)
            {
                <MudPaper Outlined="true" Class="pa-4 mt-4 confirm-panel" data-testid="delete-section">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">Delete this household</MudText>
                    @if (_confirmDelete)
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">
                            This permanently deletes @_household.Name and everything in it: its people, income, outgoings and categories.
                            Everyone else in it loses access. It can't be undone.
                        </MudText>
                        <MudTextField @bind-Value="_deleteName" Label="@($"Type {_household.Name} to confirm")" Variant="Variant.Outlined" Immediate="true"
                                      autocomplete="off" data-testid="delete-name" />
                        <div class="d-flex gap-2 flex-wrap mt-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="DeleteAsync"
                                       Disabled="@(_saving || !Online || !NameConfirmed)" data-testid="delete-yes">Delete household</MudButton>
                            <MudButton Variant="Variant.Text" OnClick="CancelDelete" data-testid="delete-cancel">Cancel</MudButton>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">Only you, as the owner, can do this.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="() => _confirmDelete = true"
                                   Disabled="!Online" data-testid="delete-household">Delete household</MudButton>
                    }
                </MudPaper>
            }
        }

        <MudText Typo="Typo.subtitle2" Class="mt-6 mb-1">What each role can do</MudText>
        <ul class="mud-typography mud-typography-body2 pl-5" data-testid="role-help">
            <li><strong>Viewer</strong>: sees the budget, income and outgoings, but can't change them.</li>
            <li><strong>User</strong>: can also add and change people, income and outgoings.</li>
            <li><strong>Admin</strong>: can also rename the household and manage its members.</li>
            <li><strong>Owner</strong>: the Admin who created the household. Only they can delete it.</li>
        </ul>
    }
</MudContainer>

@code {
    /// <summary>False while the device is offline, when changes can't be saved (BUD-38).</summary>
    [CascadingParameter(Name = "Online")]
    public bool Online { get; set; } = true;

    private HouseholdMembershipSummary? _household;
    private IReadOnlyList<HouseholdMemberSummary>? _members;
    private Guid? _userId;
    private bool _isAdmin;
    private bool _saving;
    private string? _error;
    private Guid? _removingId;
    private bool _confirmLeave;
    private bool _confirmDelete;
    private string? _deleteName;

    /// <summary>The owner has typed the household's name (ignoring case and spaces at either end).</summary>
    private bool NameConfirmed => string.Equals(_deleteName?.Trim(), _household?.Name, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _userId = (await Session.GetCurrentUserAsync())?.Id;
        _household = await Session.GetActiveHouseholdAsync();
        _isAdmin = _household?.Role == MemberRoles.Admin;
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _members = _household is null ? [] : await HouseholdApi.GetMembersAsync(_household.HouseholdId);

    private async Task ChangeRoleAsync(HouseholdMemberSummary member, string role)
    {
        if (role == member.Role)
        {
            return;
        }

        // Your own role changes what the whole app lets you do, so reload it.
        await SaveAsync(
            () => HouseholdApi.ChangeRoleAsync(_household!.HouseholdId, member.UserId, role),
            $"{member.DisplayName} is now {Article(role)} {role}.",
            reloadAppAt: member.UserId == _userId ? "/members" : null);
    }

    private Task RemoveAsync(HouseholdMemberSummary member) =>
        SaveAsync(
            () => HouseholdApi.RemoveMemberAsync(_household!.HouseholdId, member.UserId),
            $"{member.DisplayName} was removed.",
            reloadAppAt: member.UserId == _userId ? "/" : null);

    // Back to the home page, which opens another of your households.
    private Task LeaveAsync() =>
        SaveAsync(() => HouseholdApi.LeaveAsync(_household!.HouseholdId), $"You've left {_household!.Name}.", reloadAppAt: "/");

    private void CancelDelete()
    {
        _confirmDelete = false;
        _deleteName = null;
    }

    private async Task DeleteAsync()
    {
        if (!NameConfirmed)
        {
            return;
        }

        _saving = true;
        try
        {
            await HouseholdApi.DeleteAsync(_household!.HouseholdId);

            // Home opens another of your households, or offers to create one.
            Navigation.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Saves a change, then reloads the list, or the whole app when your own access has changed.</summary>
    private async Task SaveAsync(Func<Task<string?>> save, string done, string? reloadAppAt)
    {
        _saving = true;
        _error = null;
        try
        {
            _error = await save();
            _removingId = null;
            _confirmLeave = false;
            if (_error is null)
            {
                Snackbar.Add(done, Severity.Success);
                if (reloadAppAt is not null)
                {
                    Navigation.NavigateTo(reloadAppAt, forceLoad: true);
                    return;
                }
            }

            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private static string Article(string role) => role == MemberRoles.Admin ? "an" : "a";

    private static Color RoleColor(string role) => role switch
    {
        MemberRoles.Admin => Color.Primary,
        MemberRoles.User => Color.Secondary,
        _ => Color.Default,
    };
}
