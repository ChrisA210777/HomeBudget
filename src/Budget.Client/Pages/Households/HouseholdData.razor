@page "/household/data"
@attribute [Authorize]
@using Budget.Client.DataExport
@using Budget.Shared.DataExport
@using Budget.Shared.Households
@inject UserSession Session
@inject IImportApi ImportApi
@inject NavigationManager Navigation

<PageTitle>Import or export data · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4 mb-16">
    <h1 class="mud-typography mud-typography-h4 mb-2">Import or export data</h1>

    @if (_household is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_household.Role != "Admin")
    {
        <MudAlert Severity="Severity.Info" data-testid="admins-only">Only the household's Admins can download or import its data.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="1" data-testid="export-section">
            <MudText Typo="Typo.h6" Class="mb-1">Download your data</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                A backup of @_household.Name you can import again later: its people, categories, and the income and outgoings
                that are current or start in the future. Budgets and other totals aren't included, because they're worked out from these.
            </MudText>

            <MudCheckBox T="bool" @bind-Value="_includeHistory" Label="Include full history" Color="Color.Primary" data-testid="include-history" />
            <MudText Typo="Typo.caption" Class="d-block ml-10 mb-2" Color="Color.Secondary">Ended items, past price changes and pauses, and corrections.</MudText>
            <MudCheckBox T="bool" @bind-Value="_includeAudit" Label="Include who recorded what" Color="Color.Primary" data-testid="include-audit" />
            <MudText Typo="Typo.caption" Class="d-block ml-10 mb-3" Color="Color.Secondary">The name of whoever added or last changed each item, and when.</MudText>

            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-testid="export-warning">
                The file contains your household's personal and financial details. Keep it somewhere safe, and don't share it.
            </MudAlert>

            @* A plain link, so the browser downloads the file with the name the server gives it. *@
            <MudButton Href="@ExportUrl" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                       Disabled="!Online" download data-testid="download-json">Download (JSON)</MudButton>
            <MudButton Href="@CsvUrl" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TableChart"
                       Disabled="!Online" download Class="ml-sm-2 mt-2 mt-sm-0" data-testid="download-csv">Download for Excel (CSV)</MudButton>
            <MudText Typo="Typo.caption" Class="d-block mt-2" Color="Color.Secondary">
                The JSON file can be imported again. The CSV files are for opening in Excel, and can't be imported.
            </MudText>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4" Elevation="1" data-testid="import-section">
            <MudText Typo="Typo.h6" Class="mb-1">Import data</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Choose a file you downloaded from Home Budget. It's checked and summarised first; nothing changes until you choose what to do with it.
            </MudText>

            <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-medium mud-ripple import-file-button">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Class="mr-2" aria-hidden="true" />
                Choose a file (JSON)
                <InputFile OnChange="CheckFileAsync" accept=".json,application/json" class="visually-hidden" disabled="@(_checking || !Online)" data-testid="import-file" />
            </label>

            @if (_checking)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
            }

            @if (_fileName is not null && _preview is not null)
            {
                <div class="mt-4" aria-live="polite" data-testid="import-preview">
                    <MudText Typo="Typo.subtitle1"><strong>@_fileName</strong></MudText>

                    @foreach (var warning in _preview.Warnings)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" data-testid="import-warning">@warning</MudAlert>
                    }

                    @if (_preview.Errors.Count > 0)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" data-testid="import-errors">
                            <MudText Typo="Typo.body2" Class="mb-1"><strong>This file can't be imported:</strong></MudText>
                            <ul class="pl-4">
                                @foreach (var error in _preview.Errors.Take(MaxErrorsShown))
                                {
                                    <li data-testid="import-error">@Describe(error)</li>
                                }
                            </ul>
                            @if (_preview.Errors.Count > MaxErrorsShown)
                            {
                                <MudText Typo="Typo.body2" Class="mt-1">…and @(_preview.Errors.Count - MaxErrorsShown) more.</MudText>
                            }
                        </MudAlert>
                    }

                    @if (_preview.HouseholdName is not null)
                    {
                        <dl class="import-facts mt-3" data-testid="import-summary">
                            <dt>Household</dt>
                            <dd data-testid="import-household">@_preview.HouseholdName (@_preview.CurrencyCode)</dd>
                            <dt>Exported</dt>
                            <dd data-testid="import-exported">@_preview.ExportedAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") by Home Budget @_preview.AppVersion</dd>
                            <dt>Contains</dt>
                            <dd data-testid="import-counts">
                                @Count(_preview.Counts.People, "person", "people"),
                                @Count(_preview.Counts.Categories, "category", "categories"),
                                @Count(_preview.Counts.Incomes, "income", "incomes") and
                                @Count(_preview.Counts.Outgoings, "outgoing", "outgoings")
                                (@Count(_preview.Counts.HistoryEntries, "amount, pause or correction", "amounts, pauses and corrections"))
                            </dd>
                            <dt>Includes</dt>
                            <dd data-testid="import-options">@(_preview.IncludesHistory ? "Full history" : "Current and future items only")@(_preview.IncludesAudit ? ", with who recorded what" : string.Empty)</dd>
                        </dl>

                        @if (_preview.Members.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Members in the file</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-1" Color="Color.Secondary">Logins can't come from a file, so these people would need inviting again.</MudText>
                            <ul class="pl-4 mud-typography mud-typography-body2" data-testid="import-members">
                                @foreach (var member in _preview.Members)
                                {
                                    <li>@member.DisplayName@(member.Email is null ? string.Empty : $" ({member.Email})") – @(member.IsOwner ? "Owner" : member.Role)</li>
                                }
                            </ul>
                        }
                    }

                    @if (_preview.CanImport)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3" data-testid="import-ok">This file passed every check and can be imported.</MudAlert>

                        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1"><strong>Import as a new household</strong></MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Creates a separate household from the file, with you as its owner. Nothing in @_household.Name changes.
                        </MudText>
                        <MudTextField @bind-Value="_newName" Label="New household's name" MaxLength="HouseholdValidator.NameMaxLength" Variant="Variant.Outlined"
                                      Immediate="true" Class="mb-2" data-testid="import-name" />
                        @if (_preview.People.Count > 0)
                        {
                            <MudSelect T="Guid?" @bind-Value="_me" Label="Which person in the file is you?" Variant="Variant.Outlined" Class="mb-2"
                                       ToStringFunc="PersonName" data-testid="import-me">
                                <MudSelectItem T="Guid?" Value="null">None of them</MudSelectItem>
                                @foreach (var person in _preview.People)
                                {
                                    <MudSelectItem T="Guid?" Value="person.Id">@person.DisplayName</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        @if (_importErrors is { Count: > 0 })
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" data-testid="import-failed">
                                @foreach (var error in _importErrors)
                                {
                                    <div>@Describe(error)</div>
                                }
                            </MudAlert>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddHome" OnClick="ImportAsNewHouseholdAsync"
                                   Disabled="@(_importing || !Online)" data-testid="import-new-household">Import as a new household</MudButton>

                        <div class="mt-6 pa-3 confirm-panel" data-testid="replace-section">
                            <MudText Typo="Typo.subtitle1" Class="mb-1"><strong>Replace @_household.Name's data</strong></MudText>
                            <MudText Typo="Typo.body2" Class="mb-2" data-testid="replace-deletes">
                                This permanently deletes @_household.Name's
                                @Count(_preview.WouldDelete.Incomes, "income", "incomes"),
                                @Count(_preview.WouldDelete.Outgoings, "outgoing", "outgoings") (with their history),
                                @Count(_preview.WouldDelete.Categories, "category", "categories") and
                                @Count(_preview.WouldDelete.People, "person", "people") who don't sign in, and puts the file's in their place.
                                Members, their roles, and the people linked to them stay@(_preview.PeopleKept.Count > 0 ? $" ({string.Join(", ", _preview.PeopleKept)})" : string.Empty);
                                a person in the file with the same name becomes them. It can't be undone.
                            </MudText>
                            <MudButton Href="@BackupUrl" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" download
                                       Class="mb-2" data-testid="replace-backup">Download a backup first</MudButton>
                            <MudCheckBox T="bool" @bind-Value="_useFileName" Label="@($"Rename the household to “{_preview.HouseholdName}”")" Color="Color.Primary"
                                         data-testid="replace-use-file-name" />
                            <MudTextField @bind-Value="_replaceConfirm" Label="@($"Type {_household.Name} to confirm")" Variant="Variant.Outlined" Immediate="true"
                                          autocomplete="off" Class="mb-2" data-testid="replace-confirm" />
                            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.SettingsBackupRestore" OnClick="ReplaceAsync"
                                       Disabled="@(_importing || !Online || !ReplaceConfirmed)" data-testid="replace-data">Replace this household's data</MudButton>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    /// <summary>False while the device is offline, when the file can't be fetched (BUD-38).</summary>
    [CascadingParameter(Name = "Online")]
    public bool Online { get; set; } = true;

    private HouseholdMembershipSummary? _household;
    private bool _includeHistory;
    private bool _includeAudit;

    private const int MaxErrorsShown = 20;

    private bool _checking;
    private string? _fileName;
    private ImportPreviewResponse? _preview;
    private byte[]? _file;
    private string? _newName;
    private Guid? _me;
    private bool _importing;
    private bool _useFileName;
    private string? _replaceConfirm;

    private bool ReplaceConfirmed => string.Equals(_replaceConfirm?.Trim(), _household?.Name, StringComparison.OrdinalIgnoreCase);

    private string BackupUrl => DataRoutes.Export(_household!.HouseholdId, includeHistory: true, includeAudit: true);
    private IReadOnlyList<ImportProblem>? _importErrors;

    private string CsvUrl => DataRoutes.ExportCsv(_household!.HouseholdId, _includeHistory, _includeAudit);

    private string ExportUrl => DataRoutes.Export(_household!.HouseholdId, _includeHistory, _includeAudit);

    /// <summary>Reads the chosen file in the browser and sends it to be checked. It isn't kept anywhere.</summary>
    private async Task CheckFileAsync(InputFileChangeEventArgs e)
    {
        _fileName = e.File.Name;
        _preview = null;
        if (e.File.Size > ExportFormat.MaxFileBytes)
        {
            _preview = Refused($"The file is too big. Exports are at most {ExportFormat.MaxFileBytes / (1024 * 1024)} MB.");
            return;
        }

        _checking = true;
        try
        {
            using var stream = e.File.OpenReadStream(ExportFormat.MaxFileBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            _file = memory.ToArray();
            _preview = await ImportApi.PreviewAsync(_household!.HouseholdId, _file);
            _newName = _preview.HouseholdName;
            _me = _preview.People.FirstOrDefault(p => p.IsYou)?.Id;
            _importErrors = null;
        }
        catch (HttpRequestException)
        {
            _preview = Refused("The file couldn't be checked. Check your connection and try again.");
        }
        finally
        {
            _checking = false;
        }
    }

    /// <summary>Imports the checked file as a new household, then opens it (BUD-63).</summary>
    private async Task ImportAsNewHouseholdAsync()
    {
        _importing = true;
        try
        {
            var result = await ImportApi.ImportAsNewHouseholdAsync(_household!.HouseholdId, _file!, _newName, _me);
            if (!result.Succeeded)
            {
                _importErrors = result.Errors;
                return;
            }

            // It's now the active household: reload so every part of the app uses it.
            Navigation.NavigateTo("/?imported=true", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _importErrors = [new ImportProblem(string.Empty, "The file couldn't be imported. Check your connection and try again.")];
        }
        finally
        {
            _importing = false;
        }
    }

    /// <summary>Replaces this household's data with the checked file, then reloads the app in it (BUD-62).</summary>
    private async Task ReplaceAsync()
    {
        if (!ReplaceConfirmed)
        {
            return;
        }

        _importing = true;
        try
        {
            var result = await ImportApi.ReplaceAsync(_household!.HouseholdId, _file!, _useFileName);
            if (!result.Succeeded)
            {
                _importErrors = result.Errors;
                return;
            }

            Navigation.NavigateTo("/?replaced=true", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _importErrors = [new ImportProblem(string.Empty, "The data couldn't be replaced. Check your connection and try again.")];
        }
        finally
        {
            _importing = false;
        }
    }

    private string PersonName(Guid? id) =>
        id is { } personId ? _preview?.People.FirstOrDefault(p => p.Id == personId)?.DisplayName ?? string.Empty : "None of them";

    private static ImportPreviewResponse Refused(string message) => new() { Errors = [new ImportProblem(string.Empty, message)] };

    private static string Describe(ImportProblem problem) =>
        string.IsNullOrEmpty(problem.Path) ? problem.Message : $"{problem.Path}: {problem.Message}";

    private static string Count(int count, string one, string many) => $"{count} {(count == 1 ? one : many)}";

    protected override async Task OnInitializedAsync() =>
        _household = await Session.GetActiveHouseholdAsync() ?? new HouseholdMembershipSummary(Guid.Empty, string.Empty, "Viewer", false);
}
