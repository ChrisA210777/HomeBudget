@page "/transfers/{TransferId:guid}"
@attribute [Authorize]
@using Budget.Client.Income
@using Budget.Client.Outgoings
@using Budget.Client.Pages.Outgoings
@using Budget.Client.Transfers
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@using Budget.Shared.Transfers
@inject UserSession Session
@inject ITransferApi TransferApi

<PageTitle>@(_details is { } t ? TransferScheduleBackend.Title(t.Name, t.FromName, t.ToName) : "Transfer") · Home Budget</PageTitle>

@* One transfer (BUD-91): where it goes, and its amount history, pauses and ending, as for an outgoing. *@
<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-16">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/transfers" Class="mb-2">Transfers</MudButton>

    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_details is null)
    {
        <MudAlert Severity="Severity.Warning" data-testid="not-found">This transfer doesn't exist any more.</MudAlert>
    }
    else
    {
        var d = _details;

        <div class="d-flex align-start flex-wrap gap-2 mb-1">
            <div class="flex-grow-1" style="min-width: 0">
                <h1 class="mud-typography mud-typography-h4" data-testid="transfer-name">@TransferScheduleBackend.Title(d.Name, d.FromName, d.ToName)</h1>
            </div>
            <div class="text-right">
                <MudText Typo="Typo.h5" data-testid="transfer-paid">@Format(d.Amount) @OutgoingValidator.DescribeSchedule(d.Every, d.Unit)</MudText>
                @if (!(d.Every == 1 && d.Unit == PaymentUnitDto.Month))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="transfer-monthly">@Format(d.MonthlyAmount) a month</MudText>
                }
            </div>
        </div>

        @if (d.Status is { } status)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="my-2" data-testid="transfer-status">@status</MudAlert>
        }

        <MudPaper Outlined="true" Class="pa-3 my-3">
            <dl class="outgoing-facts">
                <dt>From</dt>
                <dd data-testid="from-account">@d.FromName</dd>
                <dt>Into</dt>
                <dd data-testid="to-account">@d.ToName</dd>
                <dt>Next transfer</dt>
                <dd data-testid="next-payment">@(d.NextPayment is { } next ? IncomeDates.Format(next) : "None due")</dd>
                <dt>First transfer</dt>
                <dd data-testid="first-payment">@IncomeDates.Format(d.FirstPaymentDate)</dd>
            </dl>
            @if (d.Notes is { } notes)
            {
                <MudText Typo="Typo.body2" Class="mt-2" Style="white-space: pre-wrap" data-testid="notes">@notes</MudText>
            }
        </MudPaper>

        <ScheduleHistory TDetails="TransferDetailsResponse" Details="d" DetailsChanged="(TransferDetailsResponse changed) => _details = changed" View="TransferScheduleBackend.View"
                         Backend="_backend!" CanEdit="_canEdit" Noun="transfer" EditHref="@($"/transfers/{TransferId}/edit")" ListHref="/transfers"
                         AmountPlaceholder="e.g. Bills went up" PausePlaceholder="e.g. Covered by savings this month" PauseNote="Nothing is moved for those payments." />
    }
</MudContainer>

@code {
    [Parameter]
    public Guid TransferId { get; set; }

    private HouseholdMembershipSummary? _household;
    private TransferDetailsResponse? _details;
    private TransferScheduleBackend? _backend;
    private bool _loaded;
    private bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is { TransfersEnabled: true } && _household.Role != "Viewer";
        if (_household is not null)
        {
            _backend = new TransferScheduleBackend(TransferApi, _household.HouseholdId, TransferId);
            _details = await _backend.GetAsync();
        }

        _loaded = true;
    }

    private string Format(decimal amount) => Money.Format(amount, _details?.CurrencyCode ?? "GBP");
}
