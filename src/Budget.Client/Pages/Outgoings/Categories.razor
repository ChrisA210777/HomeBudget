@page "/outgoings/categories"
@attribute [Authorize]
@using Budget.Client.Outgoings
@using Budget.Shared.Outgoings
@inject UserSession Session
@inject ICategoryApi CategoryApi
@inject ISnackbar Snackbar

<PageTitle>Categories · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-2 mb-16">
    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReceiptLong" Href="/outgoings" Class="mb-1" data-testid="go-to-outgoings">Outgoings</MudButton>
    <h1 class="mud-typography mud-typography-h4 mb-2">Categories</h1>
    <MudText Typo="Typo.body2" Class="mb-4">
        Group your bills, savings and allowances so you can see where the money goes. Hide a category you don't use;
        one with nothing in it can be deleted.
    </MudText>

    @if (_problem is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _problem = null" data-testid="problem">@_problem</MudAlert>
    }

    @if (_categories is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Outlined="true">
            @* A plain list: MudList is a selectable list box, which can't contain buttons. *@
            <ul class="plain-list" aria-label="Categories">
                @foreach (var category in _categories)
                {
                    <li class="plain-list-item" data-testid="category">
                        @if (_editingId == category.Id)
                        {
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudTextField @bind-Value="_editName"
                                              Label="Name"
                                              MaxLength="CategoryValidator.NameMaxLength"
                                              Error="_editError is not null"
                                              ErrorText="@_editError"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="flex-grow-1"
                                              data-testid="rename-name" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveRenameAsync(category)" Disabled="!Online" data-testid="rename-save">Save</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="CancelRename">Cancel</MudButton>
                            </div>
                            <CategoryIconPicker @bind-Value="_editIcon" Label="@($"Icon for {category.Name}")" />
                        }
                        else
                        {
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@CategoryIconSvg.For(category.Icon)" Color="@(category.IsHidden ? Color.Secondary : Color.Primary)" Class="mr-2" aria-hidden="true"
                                         data-testid="category-icon" data-icon="@category.Icon" />
                                <div class="flex-grow-1" style="min-width: 0">
                                    <MudText Typo="Typo.body1" Color="@(category.IsHidden ? Color.Secondary : Color.Inherit)" data-testid="category-name">@category.Name</MudText>
                                    @* The count opens Outgoings filtered to this category (BUD-98). *@
                                    @if (category.OutgoingCount > 0)
                                    {
                                        <MudLink Href="@($"/outgoings?category={category.Id}")" Typo="Typo.caption" aria-label="@($"{Usage(category)} in {category.Name}")"
                                                 Class="d-block" data-testid="category-usage">@Usage(category)</MudLink>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="category-usage">@Usage(category)</MudText>
                                    }
                                </div>
                                @if (category.IsHidden)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" data-testid="hidden">Hidden</MudChip>
                                }
                                @if (_canEdit)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="@($"Rename {category.Name} or change its icon")" OnClick="() => StartRename(category)" data-testid="rename" />
                                    <MudIconButton Icon="@(category.IsHidden ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                                   aria-label="@($"{(category.IsHidden ? "Show" : "Hide")} {category.Name}")"
                                                   OnClick="() => ToggleHiddenAsync(category)" Disabled="!Online" data-testid="toggle-hidden" />
                                    @if (category.OutgoingCount == 0)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="@($"Delete {category.Name}")"
                                                       OnClick="() => DeleteAsync(category)" Disabled="!Online" data-testid="delete" />
                                    }
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        </MudPaper>

        @if (_canEdit)
        {
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Add a category</MudText>
                <div class="d-flex align-start gap-2 flex-wrap">
                    <MudTextField @bind-Value="_newName"
                                  Label="Name"
                                  HelperText="For example, “Hobbies” or “School costs”"
                                  MaxLength="CategoryValidator.NameMaxLength"
                                  Error="_addError is not null"
                                  ErrorText="@_addError"
                                  Variant="Variant.Outlined"
                                  Class="flex-grow-1"
                                  data-testid="add-name" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync" Disabled="@(_saving || !Online)" Class="mt-2" data-testid="add-category">Add</MudButton>
                </div>
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1" id="new-icon-heading">Icon</MudText>
                <CategoryIconPicker Value="@(_newIcon ?? CategoryIcons.Default)" ValueChanged="icon => _newIcon = icon" Label="Icon for the new category" />
            </MudPaper>
        }
    }
</MudContainer>

@code {
    /// <summary>False while the device is offline, when changes can't be saved (BUD-38).</summary>
    [CascadingParameter(Name = "Online")]
    public bool Online { get; set; } = true;

    private HouseholdMembershipSummary? _household;
    private IReadOnlyList<OutgoingCategorySummary>? _categories;
    private bool _canEdit;
    private bool _saving;
    private string? _problem;

    private string? _newName;
    private string? _newIcon;
    private string? _addError;

    private Guid? _editingId;
    private string? _editName;
    private string? _editIcon;
    private string? _editError;

    protected override async Task OnInitializedAsync()
    {
        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _categories = _household is null ? [] : await CategoryApi.ListAsync(_household.HouseholdId);

    private static string Usage(OutgoingCategorySummary category) => category.OutgoingCount switch
    {
        0 => "Nothing in it yet",
        1 => "1 outgoing",
        var n => $"{n} outgoings",
    };

    private async Task AddAsync()
    {
        _addError = FirstError(CategoryValidator.ValidateName(_newName));
        if (_addError is not null)
        {
            return;
        }

        _saving = true;
        try
        {
            var name = _newName!.Trim();
            var result = await CategoryApi.AddAsync(_household!.HouseholdId, new AddCategoryRequest { Name = name, Icon = _newIcon });
            if (!result.Succeeded)
            {
                _addError = FirstError(result.Errors) ?? result.Problem;
                return;
            }

            Snackbar.Add($"{name} was added.", Severity.Success);
            _newName = null;
            _newIcon = null;
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void StartRename(OutgoingCategorySummary category)
    {
        _editingId = category.Id;
        _editName = category.Name;
        _editIcon = category.Icon;
        _editError = null;
    }

    private void CancelRename() => _editingId = null;

    private async Task SaveRenameAsync(OutgoingCategorySummary category)
    {
        _editError = FirstError(CategoryValidator.ValidateName(_editName));
        if (_editError is not null)
        {
            return;
        }

        var result = await CategoryApi.UpdateAsync(_household!.HouseholdId, category.Id, new UpdateCategoryRequest { Name = _editName!.Trim(), IsHidden = category.IsHidden, Icon = _editIcon });
        if (!result.Succeeded)
        {
            _editError = FirstError(result.Errors) ?? result.Problem;
            return;
        }

        _editingId = null;
        await LoadAsync();
    }

    private async Task ToggleHiddenAsync(OutgoingCategorySummary category)
    {
        var result = await CategoryApi.UpdateAsync(_household!.HouseholdId, category.Id, new UpdateCategoryRequest { Name = category.Name, IsHidden = !category.IsHidden });
        _problem = result.Succeeded ? null : FirstError(result.Errors) ?? result.Problem;
        await LoadAsync();
    }

    private async Task DeleteAsync(OutgoingCategorySummary category)
    {
        var result = await CategoryApi.DeleteAsync(_household!.HouseholdId, category.Id);
        if (result.Succeeded)
        {
            _problem = null;
            Snackbar.Add($"{category.Name} was deleted.", Severity.Success);
        }
        else
        {
            _problem = result.Problem ?? FirstError(result.Errors);
        }

        await LoadAsync();
    }

    private static string? FirstError(IReadOnlyDictionary<string, string[]> errors) =>
        errors.Values.SelectMany(v => v).FirstOrDefault();
}
