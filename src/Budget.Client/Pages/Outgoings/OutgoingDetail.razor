@page "/outgoings/{OutgoingId:guid}"
@attribute [Authorize]
@using Budget.Client.Income
@using Budget.Client.Outgoings
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@inject UserSession Session
@inject IOutgoingApi OutgoingApi
@inject TimeProvider Clock

<PageTitle>@(_details?.Name ?? "Outgoing") · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-16">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@BackHref" Class="mb-2" data-testid="back">@(BackLink.Name(BackHref) ?? "Back")</MudButton>

    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_details is null)
    {
        <MudAlert Severity="Severity.Warning" data-testid="not-found">This outgoing doesn't exist any more.</MudAlert>
    }
    else
    {
        var d = _details;

        <div class="d-flex align-start flex-wrap gap-2 mb-1">
            <div class="flex-grow-1" style="min-width: 0">
                <h1 class="mud-typography mud-typography-h4" data-testid="outgoing-name">@d.Name</h1>
                <div class="d-flex flex-wrap align-center gap-1 mt-1">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0" data-testid="outgoing-priority">@d.Priority</MudChip>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="outgoing-summary">
                        @KindName(d.Kind) · @d.CategoryName · @(d.PersonName ?? "The whole household")
                    </MudText>
                </div>
            </div>
            <div class="text-right">
                <MudText Typo="Typo.h5" data-testid="outgoing-paid">@Format(d.Amount) @OutgoingValidator.DescribeSchedule(d.Every, d.Unit)</MudText>
                @if (!(d.Every == 1 && d.Unit == PaymentUnitDto.Month))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="outgoing-monthly">@Format(d.MonthlyAmount) a month</MudText>
                }
            </div>
        </div>

        @if (d.Status is { } status)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="my-2" data-testid="outgoing-status">@status</MudAlert>
        }

        @if (d.IsComingUp && d.NextRenewal is { } comingUp)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2" data-testid="outgoing-coming-up">
                <b>@OutgoingValidator.RenewsIn(comingUp.DayNumber - DateOnly.FromDateTime(Clock.GetLocalNow().DateTime).DayNumber).</b>
                @OutgoingValidator.DescribeRenewal(d.Name, comingUp, d.AutoRenews)
            </MudAlert>
        }

        <MudPaper Outlined="true" Class="pa-3 my-3">
            <dl class="outgoing-facts">
                <dt>Next payment</dt>
                <dd data-testid="next-payment">@(d.NextPayment is { } next ? IncomeDates.Format(next) : "None due")</dd>
                <dt>First payment</dt>
                <dd data-testid="first-payment">@IncomeDates.Format(d.FirstPaymentDate)</dd>
                @if (d.NextRenewal is { } renewal)
                {
                    <dt>Next renewal</dt>
                    <dd data-testid="next-renewal">
                        @IncomeDates.Format(renewal) (every @d.RenewalEveryMonths month@(d.RenewalEveryMonths == 1 ? string.Empty : "s")@(d.AutoRenews ? ", renews automatically" : string.Empty))
                        @if (d.AlertPeriod != AlertPeriodDto.None)
                        {
                            <span> · Reminder @OutgoingValidator.Describe(d.AlertPeriod)</span>
                        }
                    </dd>
                }
                @if (d.Kind != OutgoingKindDto.Allowance && d.Recipient is { } recipient)
                {
                    <dt>@OutgoingValidator.RecipientLabel(d.Kind)</dt>
                    <dd data-testid="recipient">@recipient</dd>
                }
                @if (d.PaymentMethod is { } method)
                {
                    <dt>How it's paid</dt>
                    <dd data-testid="payment-method">@OutgoingValidator.Describe(method)</dd>
                }
                @if (d.PaidFrom is { } paidFrom)
                {
                    <dt>Paid from</dt>
                    <dd data-testid="paid-from">@paidFrom</dd>
                }
                @if (d.ReferenceValue is { } reference)
                {
                    <dt>@(d.ReferenceLabel ?? "Reference")</dt>
                    <dd data-testid="reference">@reference</dd>
                }
                @if (d.Website is { } website)
                {
                    <dt>Website</dt>
                    <dd><MudLink Href="@website" Target="_blank" rel="noopener noreferrer" data-testid="website">@WebsiteText(website)</MudLink></dd>
                }
                @if (d.ContactPhone is { } phone)
                {
                    <dt>Phone</dt>
                    <dd><MudLink Href="@($"tel:{TelNumber(phone)}")" data-testid="phone">@phone</MudLink></dd>
                }
            </dl>
            @if (d.Notes is { } notes)
            {
                <MudText Typo="Typo.body2" Class="mt-2" Style="white-space: pre-wrap" data-testid="notes">@notes</MudText>
            }
        </MudPaper>


        <ScheduleHistory TDetails="OutgoingDetailsResponse" Details="d" DetailsChanged="(OutgoingDetailsResponse changed) => _details = changed" View="OutgoingScheduleBackend.View" Backend="_backend!" CanEdit="_canEdit"
                         Noun="outgoing" EditHref="@BackLink.To($"/outgoings/{OutgoingId}/edit", From)" ListHref="@BackHref" />
    }
</MudContainer>

@code {
    [Parameter]
    public Guid OutgoingId { get; set; }

    /// <summary>The page this was opened from, to go back to (BUD-117).</summary>
    [SupplyParameterFromQuery(Name = BackLink.Param)]
    public string? From { get; set; }

    private string BackHref => BackLink.Resolve(From, "/outgoings");

    private HouseholdMembershipSummary? _household;
    private OutgoingDetailsResponse? _details;
    private OutgoingScheduleBackend? _backend;
    private bool _loaded;
    private bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        if (_household is not null)
        {
            _backend = new OutgoingScheduleBackend(OutgoingApi, _household.HouseholdId, OutgoingId);
            _details = await _backend.GetAsync();
        }

        _loaded = true;
    }

    private string Format(decimal amount) => Money.Format(amount, _details?.CurrencyCode ?? "GBP");

    private static string KindName(OutgoingKindDto kind) => kind switch
    {
        OutgoingKindDto.Bill => "Bill",
        OutgoingKindDto.Savings => "Savings",
        _ => "Allowance",
    };

    private static string WebsiteText(string website) =>
        Uri.TryCreate(website, UriKind.Absolute, out var uri) ? uri.Host + (uri.AbsolutePath == "/" ? string.Empty : uri.AbsolutePath) : website;

    private static string TelNumber(string phone) => new(phone.Where(c => char.IsDigit(c) || c == '+').ToArray());
}
