@page "/outgoings"
@attribute [Authorize]
@using Budget.Client.Income
@using Budget.Client.Outgoings
@using Budget.Client.People
@using Budget.Client.Accounts
@using Budget.Shared.Account
@using Budget.Shared.Accounts
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@using Budget.Shared.People
@inject UserSession Session
@inject IOutgoingApi OutgoingApi
@inject IPeopleApi PeopleApi
@inject TimeProvider Clock
@inject UserSettingsStore Settings
@inject IAccountsApi AccountsApi

<PageTitle>Outgoings · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 mb-16">
    @{
        var shown = _data is null ? [] : Filtered().ToList();
        var totals = OutgoingTotals.For(shown);
    }

    @* The title and actions stay at the top while the list scrolls; on larger screens the summary and filters do too (BUD-79). *@
    <div class="list-head" data-testid="list-head">
        <div class="list-head-title d-flex align-center gap-2" data-testid="list-head-title">
            <h1 class="mud-typography mud-typography-h4 flex-grow-1 list-head-heading">Outgoings</h1>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Event" Href="/outgoings/upcoming"
                       Class="icon-only-xs" aria-label="Upcoming payments" title="Upcoming payments" data-testid="go-to-upcoming">
                <span class="button-label">Upcoming</span>
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Category" Href="/outgoings/categories"
                       Class="icon-only-xs" aria-label="Categories" title="Categories" data-testid="go-to-categories">
                <span class="button-label">Categories</span>
            </MudButton>
            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/outgoings/new"
                           Class="icon-only-xs" aria-label="Add an outgoing" title="Add an outgoing" data-testid="add-outgoing">
                    <span class="button-label">Add an outgoing</span>
                </MudButton>
            }
        </div>

        <div class="d-flex align-center justify-space-between mb-2">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="@(IsYear ? "Start a month earlier" : "Previous month")" OnClick="() => MoveAsync(-1)" data-testid="previous-month" />
            <MudText Typo="Typo.h6" data-testid="month-name">@PeriodName</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="@(IsYear ? "Start a month later" : "Next month")" OnClick="() => MoveAsync(1)" data-testid="next-month" />
        </div>

        @if (_data is not null)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <div class="d-flex align-center justify-space-between gap-2">
                    <MudText Typo="Typo.overline">@(IsFiltered ? "Matching outgoings" : "Outgoings") @(IsYear ? "over 12 months" : "this month")</MudText>
                    @* Month or year (BUD-80): a year is the 12 monthly budget amounts added up (ADR-013). *@
                    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OverrideStyles="false" role="group" aria-label="Show amounts for" data-testid="period-toggle">
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(IsYear ? Variant.Outlined : Variant.Filled)" aria-pressed="@(IsYear ? "false" : "true")"
                                   OnClick="() => SetMonthsAsync(1)" data-testid="show-month">Month</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(IsYear ? Variant.Filled : Variant.Outlined)" aria-pressed="@(IsYear ? "true" : "false")"
                                   OnClick="() => SetMonthsAsync(12)" data-testid="show-year">Year</MudButton>
                    </MudButtonGroup>
                </div>
                <MudText Typo="Typo.h4" data-testid="month-total">@Format(totals.Total)</MudText>
                <div class="d-flex flex-wrap gap-4 mt-2">
                    <div>
                        <MudText Typo="Typo.caption" Class="d-block">Essential</MudText>
                        <MudText Typo="Typo.subtitle1" data-testid="total-essential">@Format(totals.Essential)</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Class="d-block">Preferred</MudText>
                        <MudText Typo="Typo.subtitle1" data-testid="total-preferred">@Format(totals.Preferred)</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Class="d-block">Optional</MudText>
                        <MudText Typo="Typo.subtitle1" data-testid="total-optional">@Format(totals.Optional)</MudText>
                    </div>
                </div>
            </MudPaper>

            @* One line on phones too: each filter shrinks to share the width (BUD-79). *@
            <div class="list-filters d-flex flex-wrap gap-2 pb-1" data-testid="list-filters">
                <div class="list-filter" style="width: 11rem">
                    <MudSelect T="OutgoingKindDto?" @bind-Value="_kind" ToStringFunc="KindFilterName" Label="Kind" Margin="Margin.Dense"
                               Variant="Variant.Outlined" data-testid="filter-kind">
                        <MudSelectItem T="OutgoingKindDto?" Value="null">@KindFilterName(null)</MudSelectItem>
                        @foreach (var kind in Enum.GetValues<OutgoingKindDto>())
                        {
                            <MudSelectItem T="OutgoingKindDto?" Value="kind">@KindFilterName(kind)</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="list-filter" style="width: 11rem">
                    <MudSelect T="OutgoingPriorityDto?" @bind-Value="_priority" ToStringFunc="PriorityFilterName" Label="Priority" Margin="Margin.Dense"
                               Variant="Variant.Outlined" data-testid="filter-priority">
                        <MudSelectItem T="OutgoingPriorityDto?" Value="null">@PriorityFilterName(null)</MudSelectItem>
                        @foreach (var priority in Enum.GetValues<OutgoingPriorityDto>())
                        {
                            <MudSelectItem T="OutgoingPriorityDto?" Value="priority">@PriorityFilterName(priority)</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="list-filter" style="width: 13rem">
                    <MudSelect T="string" @bind-Value="_person" ToStringFunc="PersonFilterName" Label="For" Margin="Margin.Dense"
                               Variant="Variant.Outlined" data-testid="filter-person">
                        <MudSelectItem T="string" Value="@EveryoneKey">@PersonFilterName(EveryoneKey)</MudSelectItem>
                        <MudSelectItem T="string" Value="@HouseholdKey">@PersonFilterName(HouseholdKey)</MudSelectItem>
                        @foreach (var person in _people)
                        {
                            <MudSelectItem T="string" Value="@person.Id.ToString()">@person.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                @* By the account it's paid from, including its pots (BUD-95). *@
                <div class="list-filter" style="width: 13rem">
                    <MudSelect T="Guid?" @bind-Value="_account" ToStringFunc="AccountFilterName" Label="Paid from" Margin="Margin.Dense"
                               Variant="Variant.Outlined" data-testid="filter-account">
                        <MudSelectItem T="Guid?" Value="null">@AccountFilterName(null)</MudSelectItem>
                        <MudSelectItem T="Guid?" Value="Guid.Empty">@AccountFilterName(Guid.Empty)</MudSelectItem>
                        @foreach (var account in _accounts.Where(a => a.ParentAccountId is null && (!a.IsArchived || a.Id == _account)))
                        {
                            <MudSelectItem T="Guid?" Value="account.Id">@account.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>

            @if (_category is { } categoryId)
            {
                <div class="d-flex align-center flex-wrap gap-2 pb-1" data-testid="category-filter">
                    <MudText Typo="Typo.body2">
                        Showing <b>@(_data.Items.FirstOrDefault(i => i.CategoryId == categoryId)?.CategoryName ?? "one category")</b> only.
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => _category = null" data-testid="clear-category">Show all categories</MudButton>
                </div>
            }
        }
    </div>

    @if (_household is null && _loaded)
    {
        <MudAlert Severity="Severity.Info">You're not in a household yet.</MudAlert>
    }
    else if (_data is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <div class="d-flex align-center flex-wrap gap-x-4 gap-y-1">
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.body2" id="group-by-label">Group by</MudText>
                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OverrideStyles="false" role="group" aria-labelledby="group-by-label" data-testid="group-toggle">
                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_byPaidFrom ? Variant.Outlined : Variant.Filled)" aria-pressed="@(_byPaidFrom ? "false" : "true")"
                               OnClick="() => SetGroupingAsync(false)" data-testid="group-category">Category</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_byPaidFrom ? Variant.Filled : Variant.Outlined)" aria-pressed="@(_byPaidFrom ? "true" : "false")"
                               OnClick="() => SetGroupingAsync(true)" data-testid="group-paid-from">Paid from</MudButton>
                </MudButtonGroup>
            </div>
            @if (shown.Count > 0)
            {
                var allCollapsed = AllCollapsed(shown);
                @* Collapse or expand every group at once (BUD-88). *@
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@(allCollapsed ? Icons.Material.Filled.UnfoldMore : Icons.Material.Filled.UnfoldLess)"
                           OnClick="() => SetAllCollapsed(shown, !allCollapsed)" data-testid="toggle-all-groups">
                    @(allCollapsed ? "Expand all" : "Collapse all")
                </MudButton>
            }
        </div>

        @if (_data.Items.Count == 0)
        {
            <MudPaper Class="pa-6 mt-2 text-center" Elevation="0" Outlined="true" data-testid="outgoings-empty">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="mt-2">No outgoings @(IsYear ? "in these 12 months" : "this month")</MudText>
                <MudText Typo="Typo.body2">
                    @(_canEdit
                        ? "Add your bills, savings and spending allowances, such as council tax, a holiday fund or food shopping, to see where the money goes."
                        : IsYear ? "Nobody has added any outgoings for these 12 months." : "Nobody has added any outgoings for this month.")
                </MudText>
                @if (_canEdit)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/outgoings/new" Class="mt-2">Add an outgoing</MudButton>
                }
            </MudPaper>
        }
        else if (shown.Count == 0)
        {
            <MudPaper Class="pa-6 mt-2 text-center" Elevation="0" Outlined="true" data-testid="outgoings-no-match">
                <MudText Typo="Typo.body1">Nothing matches these filters.</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearFilters" Class="mt-1">Clear filters</MudButton>
            </MudPaper>
        }

        @foreach (var group in Groups(shown))
        {
            var items = group.Items;
            var collapsed = _collapsed.Contains(group.Key);
            var listId = $"group-{group.Key.GetHashCode():x8}";
            <section class="mt-4" data-testid="@(_byPaidFrom ? "paid-from-group" : "category-group")" aria-label="@group.Name" data-collapsed="@(collapsed ? "true" : "false")">
                @* The header opens and closes the group; its total stays visible when closed (BUD-88). *@
                <h2 class="mud-typography mud-typography-subtitle1 mb-1 category-heading" style="font-weight: 600">
                    <button type="button" class="group-header" aria-expanded="@(collapsed ? "false" : "true")" aria-controls="@listId"
                            @onclick="() => ToggleGroup(group.Key)" data-testid="group-header">
                        <MudIcon Icon="@(collapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small" aria-hidden="true" />
                        @if (_byPaidFrom)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Primary" aria-hidden="true" />
                            <span data-testid="paid-from-name">@group.Name</span>
                        }
                        else
                        {
                            <MudIcon Icon="@CategoryIconSvg.For(items[0].CategoryIcon)" Size="Size.Small" Color="Color.Primary" aria-hidden="true" data-testid="category-icon" data-icon="@items[0].CategoryIcon" />
                            <span data-testid="category-name">@group.Name</span>
                        }
                        <span class="flex-grow-1"></span>
                        <span class="group-total" data-testid="category-subtotal">@Format(OutgoingTotals.Subtotal(items))</span>
                    </button>
                </h2>
                <MudPaper Outlined="true" id="@listId" hidden="@collapsed">
                    <ul class="plain-list">
                        @foreach (var item in items)
                        {
                            <li class="@($"plain-list-item{(item.IsComingUp ? " outgoing-coming-up" : string.Empty)}")" data-testid="outgoing-item">
                                <div class="d-flex align-start gap-2">
                                    <div class="flex-grow-1" style="min-width: 0">
                                        <MudLink Href="@($"/outgoings/{item.Id}")" Typo="Typo.body1" Style="font-weight: 500" data-testid="outgoing-name">@item.Name</MudLink>
                                        <div class="d-flex flex-wrap align-center gap-1 mt-1">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="PriorityColour(item.Priority)" Class="ma-0" data-testid="outgoing-priority">@item.Priority</MudChip>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@KindName(item.Kind)@(item.PersonName is { } person ? $" · {person}" : string.Empty)@(_byPaidFrom ? $" · {item.CategoryName}{(AccountOf(item).Pot is { } pot ? $" · {pot} pot" : string.Empty)}" : string.Empty)</MudText>
                                        </div>
                                        <MudText Typo="Typo.caption" Class="d-block mt-1" data-testid="outgoing-paid">@Paid(item)</MudText>
                                        @foreach (var note in item.Notes)
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block" data-testid="outgoing-note">@note</MudText>
                                        }
                                        @if (item.IsComingUp && item.NextRenewal is { } renewal)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.EventRepeat" Class="ma-0 mt-1"
                                                     title="@OutgoingValidator.DescribeRenewal(item.Name, renewal, item.AutoRenews)" data-testid="outgoing-coming-up">
                                                @OutgoingValidator.RenewsIn(renewal.DayNumber - Today.DayNumber)
                                            </MudChip>
                                        }
                                    </div>
                                    <div class="d-flex flex-column align-end text-right">
                                        <MudText Typo="Typo.subtitle1" data-testid="outgoing-monthly">@Format(item.MonthlyAmount)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="outgoing-period">@(IsYear ? "over 12 months" : "a month")</MudText>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </MudPaper>
            </section>
        }

        @* Outgoings that haven't started or have ended are out of the way, but a tap away (BUD-99). *@
        @if (_data.Inactive > 0)
        {
            <div class="d-flex align-center flex-wrap gap-2 mt-4" data-testid="inactive">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(_data.Inactive == 1 ? "1 outgoing hasn't started yet or has ended." : $"{_data.Inactive} outgoings haven't started yet or have ended.")</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => ToggleAllAsync(!_all)" data-testid="show-all">@(_all ? "Hide" : "Show")</MudButton>
            </div>
        }
    }
</MudContainer>

@code {
    /// <summary>Optional <c>?month=2026-11</c>, e.g. from the Budget page.</summary>
    [SupplyParameterFromQuery(Name = "month")]
    public string? MonthQuery { get; set; }

    /// <summary>Optional <c>?category={id}</c> to show one category, e.g. from the Budget page.</summary>
    [SupplyParameterFromQuery(Name = "category")]
    public Guid? CategoryQuery { get; set; }

    /// <summary>Show only outgoings paid from this account or pot, e.g. from the Accounts page (BUD-95).</summary>
    [SupplyParameterFromQuery(Name = "account")]
    public Guid? AccountQuery { get; set; }

    private const string EveryoneKey = "";
    private const string HouseholdKey = "household";

    private HouseholdMembershipSummary? _household;
    private OutgoingMonthResponse? _data;
    private IReadOnlyList<PersonSummary> _people = [];
    private bool _canEdit;
    private bool _all;
    private bool _loaded;
    private int _year;
    private int _month;

    /// <summary>1 for a month, 12 for the 12 months starting with it (BUD-80).</summary>
    private int _months = 1;
    private bool _byPaidFrom;

    private bool IsYear => _months == 12;

    private string PeriodName => IsYear
        ? $"{ShortMonth(_year, _month)} – {ShortMonth(new DateOnly(_year, _month, 1).AddMonths(11))}"
        : IncomeDates.MonthName(_year, _month);

    private static string ShortMonth(int year, int month) => ShortMonth(new DateOnly(year, month, 1));

    private static string ShortMonth(DateOnly date) => date.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    private Guid? _category;

    /// <summary>An account or pot, <see cref="Guid.Empty"/> for none recorded, or <c>null</c> for any (BUD-95).</summary>
    private Guid? _account;
    private IReadOnlyList<AccountSummary> _accounts = [];
    private OutgoingKindDto? _kind;
    private OutgoingPriorityDto? _priority;
    private string _person = EveryoneKey;

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    private bool IsFiltered => _category is not null || _account is not null || _kind is not null || _priority is not null || _person != EveryoneKey;

    protected override async Task OnInitializedAsync()
    {
        var today = Clock.GetLocalNow();
        (_year, _month) = (today.Year, today.Month);
        if (MonthQuery is { Length: 7 } && DateOnly.TryParseExact(MonthQuery + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var month))
        {
            (_year, _month) = (month.Year, month.Month);
        }

        _category = CategoryQuery;
        _account = AccountQuery;

        // The view and grouping chosen last time, on any device (BUD-87).
        var settings = await Settings.GetAsync();
        _months = settings.OutgoingsPeriod == ListPeriodDto.Year ? 12 : 1;
        _byPaidFrom = settings.OutgoingsGrouping == OutgoingsGroupingDto.PaidFrom;

        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        _loaded = true;
        if (_household is not null)
        {
            _people = await PeopleApi.ListAsync(_household.HouseholdId);
            _accounts = await AccountsApi.ListAsync(_household.HouseholdId);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_household is not null)
        {
            _data = await OutgoingApi.GetMonthAsync(_household.HouseholdId, _year, _month, _all, _months);
        }
    }

    private IEnumerable<OutgoingMonthItem> Filtered() =>
        _data!.Items.Where(i =>
            (_category is null || i.CategoryId == _category)
            && (_account is null || (AccountOf(i).Id ?? Guid.Empty) == _account)
            && (_kind is null || i.Kind == _kind)
            && (_priority is null || i.Priority == _priority)
            && (_person == EveryoneKey
                || (_person == HouseholdKey ? i.PersonId is null : i.PersonId?.ToString() == _person)));

    private async Task MoveAsync(int months)
    {
        var next = new DateOnly(_year, _month, 1).AddMonths(months);
        (_year, _month) = (next.Year, next.Month);
        await LoadAsync();
    }

    private async Task SetMonthsAsync(int months)
    {
        if (months != _months)
        {
            _months = months;
            await LoadAsync();
            await Settings.UpdateAsync(new UpdateUserSettingsRequest { OutgoingsPeriod = IsYear ? ListPeriodDto.Year : ListPeriodDto.Month });
        }
    }

    private async Task SetGroupingAsync(bool byPaidFrom)
    {
        if (byPaidFrom != _byPaidFrom)
        {
            _byPaidFrom = byPaidFrom;
            _collapsed.Clear();
            await Settings.UpdateAsync(new UpdateUserSettingsRequest { OutgoingsGrouping = byPaidFrom ? OutgoingsGroupingDto.PaidFrom : OutgoingsGroupingDto.Category });
        }
    }

    /// <summary>
    /// The account an outgoing is paid from, at account level: a pot counts as its account, as budgeting is done by
    /// account and pots just keep money apart (BUD-95). Falls back to the name if the account isn't in the list.
    /// </summary>
    private (Guid? Id, string? Name, string? Pot) AccountOf(OutgoingMonthItem item) => AccountLevel.Of(item.AccountId, item.PaidFrom, _accounts);

    /// <summary>Accounts with no Paid From go last, as "Not set".</summary>
    internal const string PaidFromNotSet = "Not set";

    /// <summary><see cref="Key"/> is the category's id, or the Paid From name in lower case.</summary>
    private sealed record ItemGroup(string Key, string Name, List<OutgoingMonthItem> Items);

    /// <summary>Groups closed to their header, kept for this visit (BUD-88).</summary>
    private readonly HashSet<string> _collapsed = [];

    private void ToggleGroup(string key)
    {
        if (!_collapsed.Remove(key))
        {
            _collapsed.Add(key);
        }
    }

    private bool AllCollapsed(List<OutgoingMonthItem> shown) => Groups(shown).All(g => _collapsed.Contains(g.Key));

    private void SetAllCollapsed(List<OutgoingMonthItem> shown, bool collapse)
    {
        _collapsed.Clear();
        if (collapse)
        {
            _collapsed.UnionWith(Groups(shown).Select(g => g.Key));
        }
    }

    /// <summary>
    /// Category groups keep the server's order (the household's category order); Paid From groups are by
    /// name, ignoring case and spaces at either end, with "Not set" last.
    /// </summary>
    private IEnumerable<ItemGroup> Groups(List<OutgoingMonthItem> items) => _byPaidFrom
        ? items
            .GroupBy(i => AccountOf(i).Name, StringComparer.CurrentCultureIgnoreCase)
            .OrderBy(g => g.Key is null)
            .ThenBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(g => new ItemGroup(
                g.Key?.ToLowerInvariant() ?? string.Empty, g.Key ?? PaidFromNotSet, g.OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase).ToList()))
        : items.GroupBy(i => i.CategoryId).Select(g => new ItemGroup(g.Key.ToString(), g.First().CategoryName, g.ToList()));

    private async Task ToggleAllAsync(bool value)
    {
        _all = value;
        await LoadAsync();
    }

    private void ClearFilters()
    {
        _category = null;
        _account = null;
        _kind = null;
        _priority = null;
        _person = EveryoneKey;
    }

    private string Format(decimal amount) => Money.Format(amount, _data?.CurrencyCode ?? "GBP");

    private string Paid(OutgoingMonthItem item) =>
        $"{Format(item.Amount)} {OutgoingValidator.DescribeSchedule(item.Every, item.Unit)}";

    private static string KindName(OutgoingKindDto kind) => kind switch
    {
        OutgoingKindDto.Bill => "Bill",
        OutgoingKindDto.Savings => "Savings",
        _ => "Allowance",
    };

    private static Color PriorityColour(OutgoingPriorityDto priority) => priority switch
    {
        OutgoingPriorityDto.Essential => Color.Error,
        OutgoingPriorityDto.Preferred => Color.Info,
        _ => Color.Default,
    };

    private static string KindFilterName(OutgoingKindDto? kind) => kind switch
    {
        null => "All",
        OutgoingKindDto.Bill => "Bills",
        OutgoingKindDto.Savings => "Savings",
        _ => "Allowances",
    };

    private static string PriorityFilterName(OutgoingPriorityDto? priority) => priority?.ToString() ?? "All";

    private string AccountFilterName(Guid? id) => id switch
    {
        null => "All",
        var none when none == Guid.Empty => "Not set",
        _ => _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "That account",
    };

    private string PersonFilterName(string key) => key switch
    {
        EveryoneKey => "Everyone",
        HouseholdKey => "Household",
        _ => _people.FirstOrDefault(p => p.Id.ToString() == key)?.DisplayName ?? string.Empty,
    };
}
