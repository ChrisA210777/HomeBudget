@page "/outgoings"
@attribute [Authorize]
@using Budget.Client.Income
@using Budget.Client.Outgoings
@using Budget.Client.People
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@using Budget.Shared.People
@inject UserSession Session
@inject IOutgoingApi OutgoingApi
@inject IPeopleApi PeopleApi
@inject TimeProvider Clock

<PageTitle>Outgoings · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-16">
    <div class="d-flex align-center flex-wrap gap-2 mb-2">
        <h1 class="mud-typography mud-typography-h4 flex-grow-1">Outgoings</h1>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Category" Href="/outgoings/categories" data-testid="go-to-categories">
            Categories
        </MudButton>
        @if (_canEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/outgoings/new" data-testid="add-outgoing">
                Add an outgoing
            </MudButton>
        }
    </div>

    <div class="d-flex align-center justify-space-between mb-3">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous month" OnClick="() => MoveAsync(-1)" data-testid="previous-month" />
        <MudText Typo="Typo.h6" data-testid="month-name">@IncomeDates.MonthName(_year, _month)</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next month" OnClick="() => MoveAsync(1)" data-testid="next-month" />
    </div>

    @if (_household is null && _loaded)
    {
        <MudAlert Severity="Severity.Info">You're not in a household yet.</MudAlert>
    }
    else if (_data is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        var shown = Filtered().ToList();
        var totals = OutgoingTotals.For(shown);

        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudText Typo="Typo.overline">@(IsFiltered ? "Matching outgoings this month" : "Outgoings this month")</MudText>
            <MudText Typo="Typo.h4" data-testid="month-total">@Format(totals.Total)</MudText>
            <div class="d-flex flex-wrap gap-4 mt-2">
                <div>
                    <MudText Typo="Typo.caption" Class="d-block">Essential</MudText>
                    <MudText Typo="Typo.subtitle1" data-testid="total-essential">@Format(totals.Essential)</MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="d-block">Preferred</MudText>
                    <MudText Typo="Typo.subtitle1" data-testid="total-preferred">@Format(totals.Preferred)</MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="d-block">Optional</MudText>
                    <MudText Typo="Typo.subtitle1" data-testid="total-optional">@Format(totals.Optional)</MudText>
                </div>
            </div>
        </MudPaper>

        <div class="d-flex flex-wrap gap-2 mb-1">
            <div style="width: 11rem">
                <MudSelect T="OutgoingKindDto?" @bind-Value="_kind" ToStringFunc="KindFilterName" Label="Kind" Margin="Margin.Dense"
                           Variant="Variant.Outlined" data-testid="filter-kind">
                    <MudSelectItem T="OutgoingKindDto?" Value="null">@KindFilterName(null)</MudSelectItem>
                    @foreach (var kind in Enum.GetValues<OutgoingKindDto>())
                    {
                        <MudSelectItem T="OutgoingKindDto?" Value="kind">@KindFilterName(kind)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 11rem">
                <MudSelect T="OutgoingPriorityDto?" @bind-Value="_priority" ToStringFunc="PriorityFilterName" Label="Priority" Margin="Margin.Dense"
                           Variant="Variant.Outlined" data-testid="filter-priority">
                    <MudSelectItem T="OutgoingPriorityDto?" Value="null">@PriorityFilterName(null)</MudSelectItem>
                    @foreach (var priority in Enum.GetValues<OutgoingPriorityDto>())
                    {
                        <MudSelectItem T="OutgoingPriorityDto?" Value="priority">@PriorityFilterName(priority)</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div style="width: 13rem">
                <MudSelect T="string" @bind-Value="_person" ToStringFunc="PersonFilterName" Label="For" Margin="Margin.Dense"
                           Variant="Variant.Outlined" data-testid="filter-person">
                    <MudSelectItem T="string" Value="@EveryoneKey">@PersonFilterName(EveryoneKey)</MudSelectItem>
                    <MudSelectItem T="string" Value="@HouseholdKey">@PersonFilterName(HouseholdKey)</MudSelectItem>
                    @foreach (var person in _people)
                    {
                        <MudSelectItem T="string" Value="@person.Id.ToString()">@person.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </div>

        @if (_category is { } categoryId)
        {
            <div class="d-flex align-center flex-wrap gap-2 mb-1" data-testid="category-filter">
                <MudText Typo="Typo.body2">
                    Showing <b>@(_data.Items.FirstOrDefault(i => i.CategoryId == categoryId)?.CategoryName ?? "one category")</b> only.
                </MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => _category = null" data-testid="clear-category">Show all categories</MudButton>
            </div>
        }

        <MudSwitch T="bool" Value="_all" ValueChanged="ToggleAllAsync" Color="Color.Primary" Label="Show all, including ones not started or ended" data-testid="show-all" />

        @if (_data.Items.Count == 0)
        {
            <MudPaper Class="pa-6 mt-2 text-center" Elevation="0" Outlined="true" data-testid="outgoings-empty">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="mt-2">No outgoings this month</MudText>
                <MudText Typo="Typo.body2">
                    @(_canEdit
                        ? "Add your bills, savings and spending allowances, such as council tax, a holiday fund or food shopping, to see where the money goes."
                        : "Nobody has added any outgoings for this month.")
                </MudText>
                @if (_canEdit)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/outgoings/new" Class="mt-2">Add an outgoing</MudButton>
                }
            </MudPaper>
        }
        else if (shown.Count == 0)
        {
            <MudPaper Class="pa-6 mt-2 text-center" Elevation="0" Outlined="true" data-testid="outgoings-no-match">
                <MudText Typo="Typo.body1">Nothing matches these filters.</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearFilters" Class="mt-1">Clear filters</MudButton>
            </MudPaper>
        }

        @foreach (var group in shown.GroupBy(i => i.CategoryId))
        {
            var items = group.ToList();
            <section class="mt-4" data-testid="category-group" aria-label="@items[0].CategoryName">
                <div class="d-flex align-baseline justify-space-between mb-1 category-heading">
                    <h2 class="mud-typography mud-typography-subtitle1 d-flex align-center gap-2" style="font-weight: 600">
                        <MudIcon Icon="@CategoryIconSvg.For(items[0].CategoryIcon)" Size="Size.Small" Color="Color.Primary" aria-hidden="true" data-testid="category-icon" data-icon="@items[0].CategoryIcon" />
                        <span data-testid="category-name">@items[0].CategoryName</span>
                    </h2>
                    <MudText Typo="Typo.subtitle1" data-testid="category-subtotal">@Format(OutgoingTotals.Subtotal(items))</MudText>
                </div>
                <MudPaper Outlined="true">
                    <ul class="plain-list">
                        @foreach (var item in items)
                        {
                            <li class="@($"plain-list-item{(item.IsComingUp ? " outgoing-coming-up" : string.Empty)}")" data-testid="outgoing-item">
                                <div class="d-flex align-start gap-2">
                                    <div class="flex-grow-1" style="min-width: 0">
                                        <MudLink Href="@($"/outgoings/{item.Id}")" Typo="Typo.body1" Style="font-weight: 500" data-testid="outgoing-name">@item.Name</MudLink>
                                        <div class="d-flex flex-wrap align-center gap-1 mt-1">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="PriorityColour(item.Priority)" Class="ma-0" data-testid="outgoing-priority">@item.Priority</MudChip>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@KindName(item.Kind)@(item.PersonName is { } person ? $" · {person}" : string.Empty)</MudText>
                                        </div>
                                        <MudText Typo="Typo.caption" Class="d-block mt-1" data-testid="outgoing-paid">@Paid(item)</MudText>
                                        @foreach (var note in item.Notes)
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block" data-testid="outgoing-note">@note</MudText>
                                        }
                                        @if (item.IsComingUp && item.NextRenewal is { } renewal)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.EventRepeat" Class="ma-0 mt-1"
                                                     title="@OutgoingValidator.DescribeRenewal(item.Name, renewal, item.AutoRenews)" data-testid="outgoing-coming-up">
                                                @OutgoingValidator.RenewsIn(renewal.DayNumber - Today.DayNumber)
                                            </MudChip>
                                        }
                                    </div>
                                    <div class="d-flex flex-column align-end text-right">
                                        <MudText Typo="Typo.subtitle1" data-testid="outgoing-monthly">@Format(item.MonthlyAmount)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="outgoing-period">a month</MudText>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </MudPaper>
            </section>
        }
    }
</MudContainer>

@code {
    /// <summary>Optional <c>?month=2026-11</c>, e.g. from the Budget page.</summary>
    [SupplyParameterFromQuery(Name = "month")]
    public string? MonthQuery { get; set; }

    /// <summary>Optional <c>?category={id}</c> to show one category, e.g. from the Budget page.</summary>
    [SupplyParameterFromQuery(Name = "category")]
    public Guid? CategoryQuery { get; set; }

    private const string EveryoneKey = "";
    private const string HouseholdKey = "household";

    private HouseholdMembershipSummary? _household;
    private OutgoingMonthResponse? _data;
    private IReadOnlyList<PersonSummary> _people = [];
    private bool _canEdit;
    private bool _all;
    private bool _loaded;
    private int _year;
    private int _month;

    private Guid? _category;
    private OutgoingKindDto? _kind;
    private OutgoingPriorityDto? _priority;
    private string _person = EveryoneKey;

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    private bool IsFiltered => _category is not null || _kind is not null || _priority is not null || _person != EveryoneKey;

    protected override async Task OnInitializedAsync()
    {
        var today = Clock.GetLocalNow();
        (_year, _month) = (today.Year, today.Month);
        if (MonthQuery is { Length: 7 } && DateOnly.TryParseExact(MonthQuery + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var month))
        {
            (_year, _month) = (month.Year, month.Month);
        }

        _category = CategoryQuery;

        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        _loaded = true;
        if (_household is not null)
        {
            _people = await PeopleApi.ListAsync(_household.HouseholdId);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_household is not null)
        {
            _data = await OutgoingApi.GetMonthAsync(_household.HouseholdId, _year, _month, _all);
        }
    }

    private IEnumerable<OutgoingMonthItem> Filtered() =>
        _data!.Items.Where(i =>
            (_category is null || i.CategoryId == _category)
            && (_kind is null || i.Kind == _kind)
            && (_priority is null || i.Priority == _priority)
            && (_person == EveryoneKey
                || (_person == HouseholdKey ? i.PersonId is null : i.PersonId?.ToString() == _person)));

    private async Task MoveAsync(int months)
    {
        var next = new DateOnly(_year, _month, 1).AddMonths(months);
        (_year, _month) = (next.Year, next.Month);
        await LoadAsync();
    }

    private async Task ToggleAllAsync(bool value)
    {
        _all = value;
        await LoadAsync();
    }

    private void ClearFilters()
    {
        _category = null;
        _kind = null;
        _priority = null;
        _person = EveryoneKey;
    }

    private string Format(decimal amount) => Money.Format(amount, _data?.CurrencyCode ?? "GBP");

    private string Paid(OutgoingMonthItem item) =>
        $"{Format(item.Amount)} {OutgoingValidator.DescribeSchedule(item.Every, item.Unit)}";

    private static string KindName(OutgoingKindDto kind) => kind switch
    {
        OutgoingKindDto.Bill => "Bill",
        OutgoingKindDto.Savings => "Savings",
        _ => "Allowance",
    };

    private static Color PriorityColour(OutgoingPriorityDto priority) => priority switch
    {
        OutgoingPriorityDto.Essential => Color.Error,
        OutgoingPriorityDto.Preferred => Color.Info,
        _ => Color.Default,
    };

    private static string KindFilterName(OutgoingKindDto? kind) => kind switch
    {
        null => "All kinds",
        OutgoingKindDto.Bill => "Bills",
        OutgoingKindDto.Savings => "Savings",
        _ => "Allowances",
    };

    private static string PriorityFilterName(OutgoingPriorityDto? priority) => priority?.ToString() ?? "All priorities";

    private string PersonFilterName(string key) => key switch
    {
        EveryoneKey => "Everyone",
        HouseholdKey => "The whole household",
        _ => _people.FirstOrDefault(p => p.Id.ToString() == key)?.DisplayName ?? string.Empty,
    };
}
