@page "/outgoings/upcoming"
@attribute [Authorize]
@using System.Globalization
@using Budget.Client.Accounts
@using Budget.Client.Outgoings
@using Budget.Shared.Accounts
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@inject UserSession Session
@inject IUpcomingPaymentsApi PaymentsApi
@inject UserSettingsStore Settings
@inject IAccountsApi AccountsApi
@inject TimeProvider Clock

<PageTitle>Upcoming payments · Home Budget</PageTitle>

@* What's actually due each day (BUD-82, ADR-013): real amounts on their dates, not monthly averages. *@
<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 mb-16">
    <h1 class="mud-typography mud-typography-h4 mt-2 mb-1">Upcoming payments</h1>
    <MudText Typo="Typo.body2" Class="mb-3">
        What's due each day, at the amount actually paid. Unlike the budget, a yearly bill only shows on the day it's paid.
    </MudText>

    @* The account filter; week or month is chosen from the period's name (BUD-124, BUD-135). *@
    <div class="page-toolbar mb-2">
        @* By account, including its pots: budgeting is done by account (BUD-96). A compact menu, not a form field. *@
        <MudMenu Label="@(_account is null ? "All accounts" : AccountName(_account))"
                 StartIcon="@Icons.Material.Filled.AccountBalance"
                 EndIcon="@Icons.Material.Filled.ArrowDropDown"
                 Variant="Variant.Outlined"
                 Color="Color.Primary"
                 Size="Size.Small"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 AriaLabel="@($"Paid from: {(_account is null ? "all accounts" : AccountName(_account))}. Change the account")"
                 Class="toolbar-menu"
                 data-testid="filter-account">
            <MudText Typo="Typo.overline" Class="px-4 pt-2">Paid from</MudText>
            @foreach (var (id, name) in AccountChoices())
            {
                <MudMenuItem Icon="@(id == _account ? Icons.Material.Filled.Check : null)" OnClick="() => _account = id" data-testid="filter-account-option">@name</MudMenuItem>
            }
        </MudMenu>
    </div>

    <PeriodNavigator Name="@PeriodName" IsCurrent="@(_from <= Today && Today <= _to)" Class="mb-2"
                     PreviousLabel="@(_month ? "Previous month" : "Previous week")" NextLabel="@(_month ? "Next month" : "Next week")"
                     OnPrevious="() => MoveAsync(-1)" OnNext="() => MoveAsync(1)" OnToday="GoToTodayAsync"
                     Choices="@WeekOrMonth" />

    @if (_loaded && _household is null)
    {
        <MudAlert Severity="Severity.Info">You're not in a household yet.</MudAlert>
    }
    else if (_data is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        var rows = Rows().ToList();
        var outRows = rows.Where(r => !r.IsIn).ToList();
        var inTotal = rows.Where(r => r.IsIn).Sum(r => r.Amount);
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudText Typo="Typo.overline">Going out @(_month ? "this month" : "this week")@(_account is null ? string.Empty : $" from {AccountName(_account)}")</MudText>
            <MudText Typo="Typo.h4" data-testid="period-total">@Format(outRows.Sum(r => r.Amount))</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="payment-count">@Count(outRows.Count)</MudText>
            @if (inTotal > 0)
            {
                @* Income arriving in the period (BUD-58). *@
                <MudText Typo="Typo.body1" Class="mt-2 d-flex align-center gap-1" data-testid="period-income">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Color="Color.Success" aria-hidden="true" />
                    Coming in @Format(inTotal)
                </MudText>
            }
        </MudPaper>

        @if (rows.Count == 0)
        {
            <MudPaper Class="pa-6 text-center" Elevation="0" Outlined="true" data-testid="payments-empty">
                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body1" Class="mt-2">Nothing is due @(_month ? "this month" : "this week")@(_account is null ? string.Empty : $" from {AccountName(_account)}").</MudText>
            </MudPaper>
        }
        else
        {
            @Days(rows)
        }
    }
</MudContainer>

@code {
    private static readonly CultureInfo Display = CultureInfo.InvariantCulture;

    private HouseholdMembershipSummary? _household;
    private UpcomingPaymentsResponse? _data;
    private bool _loaded;
    private bool _month;

    /// <summary>An account (with its pots), <see cref="Guid.Empty"/> for none recorded, or <c>null</c> for all (BUD-96).</summary>
    private Guid? _account;
    private IReadOnlyList<AccountSummary> _accounts = [];

    private (Guid? Id, string? Name, string? Pot) AccountOf(UpcomingPayment payment) => AccountLevel.Of(payment.AccountId, payment.PaidFrom, _accounts);

    /// <summary>A payment out or income in (BUD-58), as listed on a day.</summary>
    private sealed record Row(DateOnly Date, bool IsIn, string Name, decimal Amount, string Details, string Icon, string Href, int Sort);

    /// <summary>Payments and income in the period, for the chosen account (with its pots) or all of them.</summary>
    private IEnumerable<Row> Rows()
    {
        var payments = (_data?.Payments ?? [])
            .Where(p => Matches(AccountOf(p).Id))
            .Select(p => new Row(p.Date, false, p.Name, p.Amount, Details(p), CategoryIconSvg.For(p.CategoryIcon), BackLink.To($"/outgoings/{p.OutgoingId}", "/outgoings/upcoming"), p.CategorySortOrder));
        var income = (_data?.Income ?? [])
            .Where(i => Matches(AccountLevel.Of(i.AccountId, i.PaidInto, _accounts).Id))
            .Select(i => new Row(i.Date, true, i.Name, i.Amount, Details(i), Icons.Material.Filled.ArrowDownward, BackLink.To($"/income/{i.IncomeStreamId}", "/outgoings/upcoming"), -1));
        return income.Concat(payments).OrderBy(r => r.Date).ThenBy(r => r.Sort).ThenBy(r => r.Name, StringComparer.CurrentCultureIgnoreCase);
    }

    private bool Matches(Guid? accountId) => _account is null || (accountId ?? Guid.Empty) == _account;

    private string AccountName(Guid? id) => id switch
    {
        null => "All",
        var none when none == Guid.Empty => "Not set",
        _ => _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "That account",
    };
    private DayOfWeek _firstDay = DayOfWeek.Sunday;
    private DateOnly _from;
    private DateOnly _to;

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    private IReadOnlyList<PeriodChoice> WeekOrMonth =>
        [new("A week", "show-week", !_month, EventCallback.Factory.Create(this, () => SetMonthAsync(false))), new("A month", "show-month", _month, EventCallback.Factory.Create(this, () => SetMonthAsync(true)))];

    private string PeriodName => _month ? PeriodNames.Month(_from.Year, _from.Month) : PeriodNames.Days(_from, _to);

    private IEnumerable<(Guid? Id, string Name)> AccountChoices()
    {
        yield return (null, "All accounts");
        yield return (Guid.Empty, AccountName(Guid.Empty));
        foreach (var account in _accounts.Where(a => a.ParentAccountId is null && (!a.IsArchived || a.Id == _account)))
        {
            yield return (account.Id, account.Name);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // The week starts on the day chosen in Settings (BUD-87); Sunday unless changed.
        _firstDay = (await Settings.GetAsync()).FirstDayOfWeek;
        (_from, _to) = PaymentPeriods.WeekOf(Today, _firstDay);
        _household = await Session.GetActiveHouseholdAsync();
        if (_household is not null)
        {
            _accounts = await AccountsApi.ListAsync(_household.HouseholdId);
        }

        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_household is not null)
        {
            _data = await PaymentsApi.GetAsync(_household.HouseholdId, _from, _to);
        }
    }

    private async Task SetMonthAsync(bool month)
    {
        if (month == _month)
        {
            return;
        }

        // Keep looking at the same time: the month containing the week's first day, or this week if it's in the month.
        _month = month;
        var anchor = month ? _from : (_from <= Today && Today <= _to ? Today : _from);
        (_from, _to) = month ? PaymentPeriods.MonthOf(anchor) : PaymentPeriods.WeekOf(anchor, _firstDay);
        await LoadAsync();
    }

    private async Task MoveAsync(int step)
    {
        (_from, _to) = _month ? PaymentPeriods.MonthOf(_from.AddMonths(step)) : PaymentPeriods.WeekOf(_from.AddDays(7 * step), _firstDay);
        await LoadAsync();
    }

    private async Task GoToTodayAsync()
    {
        (_from, _to) = _month ? PaymentPeriods.MonthOf(Today) : PaymentPeriods.WeekOf(Today, _firstDay);
        await LoadAsync();
    }

    /// <summary>
    /// The days with something due or arriving, each with its payments and total; days with nothing are left out. A day
    /// with income shows its net, signed; otherwise what goes out.
    /// </summary>
    private RenderFragment Days(IEnumerable<Row> rows) =>
        @<div>
        @foreach (var day in rows.GroupBy(r => r.Date).OrderBy(g => g.Key))
        {
            var isToday = day.Key == Today;
            var hasIncome = day.Any(r => r.IsIn);
            var net = day.Sum(r => r.IsIn ? r.Amount : -r.Amount);
            <div class="mb-3" data-testid="payment-day" data-date="@day.Key.ToString("yyyy-MM-dd", Display)">
                <div class="d-flex align-center gap-2 mb-1 category-heading">
                    <MudText Typo="Typo.subtitle2" data-testid="payment-day-name">@day.Key.ToString("ddd d MMM", Display)</MudText>
                    @if (isToday)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ma-0" data-testid="payment-today">Today</MudChip>
                    }
                    <span class="flex-grow-1"></span>
                    <MudText Typo="Typo.subtitle2" data-testid="payment-day-total">@(hasIncome ? Signed(net) : Format(-net))</MudText>
                </div>
                <MudPaper Outlined="true">
                    <ul class="plain-list">
                        @foreach (var row in day)
                        {
                            <li class="plain-list-item" data-testid="@(row.IsIn ? "income" : "payment")">
                                <div class="d-flex align-start gap-2">
                                    <MudIcon Icon="@row.Icon" Size="Size.Small" Color="@(row.IsIn ? Color.Success : Color.Secondary)" Class="mt-1" aria-hidden="true" />
                                    <div class="flex-grow-1" style="min-width: 0">
                                        <MudLink Href="@row.Href" Typo="Typo.body1" data-testid="@(row.IsIn ? "income-name" : "payment-name")">@row.Name</MudLink>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block" data-testid="@(row.IsIn ? "income-details" : "payment-details")">@row.Details</MudText>
                                    </div>
                                    <MudText Typo="Typo.subtitle1" Class="text-right text-nowrap" data-testid="@(row.IsIn ? "income-amount" : "payment-amount")">@(row.IsIn ? "+" : string.Empty)@Format(row.Amount)</MudText>
                                </div>
                            </li>
                        }
                    </ul>
                </MudPaper>
            </div>
        }
        </div>;

    /// <summary>e.g. "Monthly · Income · into Joint › Bills · Jane".</summary>
    private static string Details(UpcomingIncome income)
    {
        var parts = new List<string> { PaymentPeriods.Frequency(income.Every, income.Unit), "Income" };
        if (!string.IsNullOrWhiteSpace(income.PaidInto))
        {
            parts.Add($"into {income.PaidInto.Trim()}");
        }

        if (income.PersonName is { } person)
        {
            parts.Add(person);
        }

        return string.Join(" · ", parts);
    }

    private string Signed(decimal amount) => amount < 0 ? $"−{Format(-amount)}" : $"+{Format(amount)}";

    private string Details(UpcomingPayment payment)
    {
        var parts = new List<string> { PaymentPeriods.Frequency(payment.Every, payment.Unit), payment.CategoryName };
        if (!string.IsNullOrWhiteSpace(payment.PaidFrom))
        {
            parts.Add($"from {payment.PaidFrom.Trim()}");
        }

        if (payment.PersonName is { } person)
        {
            parts.Add(person);
        }

        return string.Join(" · ", parts);
    }

    private static string Count(int count) => count == 1 ? "1 payment" : $"{count} payments";

    private string Format(decimal amount) => Money.Format(amount, _data?.CurrencyCode ?? "GBP");
}
