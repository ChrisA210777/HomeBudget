@* The frame for the privacy notice and terms (BUD-152): readable width, the heading and version, then the text. *@

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-16">
    <article class="legal" data-testid="legal-page">
        <LegalHeader Title="@Title" Version="@Version" />
        @ChildContent
        @if (Other is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-6">See also the <MudLink Underline="Underline.Always" Href="@OtherHref">@Other</MudLink>.</MudText>
        }
    </article>
</MudContainer>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Version { get; set; } = string.Empty;

    [Parameter]
    public string? Other { get; set; }

    [Parameter]
    public string? OtherHref { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
