@page "/cash-flow"
@attribute [Authorize]
@using System.Globalization
@using Budget.Client.CashFlow
@using Budget.Client.Income
@using Budget.Client.Outgoings
@using Budget.Shared.CashFlow
@using Budget.Shared.Income
@inject UserSession Session
@inject ICashFlowApi CashFlowApi
@inject UserSettingsStore Settings
@inject TimeProvider Clock

<PageTitle>Cash flow · Home Budget</PageTitle>

@* Money in and out of each account, with its pots (BUD-92, ADR-014): monthly budget amounts, or day by day. *@
<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 mb-16">
    <div class="d-flex align-center flex-wrap gap-2 mb-1">
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountBalance" Href="/accounts" data-testid="go-to-accounts">Accounts</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz" Href="/transfers" data-testid="go-to-transfers">Transfers</MudButton>
    </div>
    <h1 class="mud-typography mud-typography-h4 mb-1">Cash flow</h1>
    <MudText Typo="Typo.body2" Class="mb-3">
        Money into and out of each account, with its pots counted in. Transfers between an account and its own pots aren't shown, as the money stays in the account.
    </MudText>

    @if (_loaded && _household is not { TransfersEnabled: true })
    {
        <MudAlert Severity="Severity.Info" data-testid="cash-flow-off">
            Cash flow needs transfers turned on. An Admin can turn them on from the <MudLink Href="/accounts">Accounts</MudLink> page.
        </MudAlert>
    }
    else
    {
        @* One toolbar, as on Upcoming payments (BUD-130). Week or month is chosen from the period's name (BUD-135). *@
        <div class="page-toolbar cash-flow-toolbar flex-wrap mb-2">
            <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OverrideStyles="false" role="group" aria-label="Show" data-testid="view-toggle">
                <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_daily ? Variant.Outlined : Variant.Filled)" aria-pressed="@(_daily ? "false" : "true")"
                           OnClick="() => SetDailyAsync(false)" data-testid="show-monthly">Monthly</MudButton>
                <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_daily ? Variant.Filled : Variant.Outlined)" aria-pressed="@(_daily ? "true" : "false")"
                           OnClick="() => SetDailyAsync(true)" data-testid="show-daily">Day by day</MudButton>
            </MudButtonGroup>
            @if (_daily)
            {
                @if (_days is { Accounts.Count: > 0 } days)
                {
                    <MudMenu Label="@(SelectedDays?.Name ?? "Account")"
                             StartIcon="@Icons.Material.Filled.AccountBalance"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown"
                             Variant="Variant.Outlined"
                             Color="Color.Primary"
                             Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             AriaLabel="@($"Account: {SelectedDays?.Name}. Change the account")"
                             Class="toolbar-menu"
                             data-testid="day-account">
                        <MudText Typo="Typo.overline" Class="px-4 pt-2">Account</MudText>
                        @foreach (var account in days.Accounts)
                        {
                            <MudMenuItem Icon="@(account.AccountId == SelectedDays?.AccountId ? Icons.Material.Filled.Check : null)" OnClick="() => _account = account.AccountId"
                                         data-testid="day-account-option">@account.Name</MudMenuItem>
                        }
                    </MudMenu>
                }
            }
        </div>

        <PeriodNavigator Name="@PeriodName" IsCurrent="@(_from <= Today && Today <= _to)" Class="mb-2"
                         PreviousLabel="@(Monthly ? "Previous month" : "Previous week")" NextLabel="@(Monthly ? "Next month" : "Next week")"
                         OnPrevious="() => MoveAsync(-1)" OnNext="() => MoveAsync(1)" OnToday="GoToTodayAsync"
                         Choices="@(_daily ? WeekOrMonth : null)" />

        @if (!_daily)
        {
            @if (_monthData is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_monthData.Accounts.Count == 0)
            {
                <MudPaper Class="pa-6 text-center" Elevation="0" Outlined="true" data-testid="cash-flow-empty">
                    <MudText Typo="Typo.body1">Nothing goes in or out this month.</MudText>
                </MudPaper>
            }
            else
            {
                @foreach (var account in _monthData.Accounts)
                {
                    <MudPaper Outlined="true" Class="pa-3 mb-3" data-testid="cash-flow-account">
                        <div class="d-flex align-center flex-wrap gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Primary" aria-hidden="true" />
                            <h2 class="mud-typography mud-typography-subtitle1 flex-grow-1 ma-0" style="font-weight: 600" data-testid="account-name">@account.Name</h2>
                            @Net(account.Net, _monthData.CurrencyCode)
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="account-totals">
                            In @Format(account.TotalIn, _monthData.CurrencyCode) · Out @Format(account.TotalOut, _monthData.CurrencyCode)
                        </MudText>
                        <div class="cash-flow-lines mt-2">
                            @foreach (var entry in account.In.Concat(account.Out))
                            {
                                <div class="d-flex align-center gap-2" data-testid="cash-flow-line">
                                    <MudIcon Icon="@(entry.IsIn ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small"
                                             Color="@(entry.IsIn ? Color.Success : Color.Default)" aria-hidden="true" />
                                    <MudLink Href="@Link(entry)" Typo="Typo.body2" Class="flex-grow-1" data-testid="line-name">@Label(entry)</MudLink>
                                    <MudText Typo="Typo.body2" Class="text-nowrap" data-testid="line-amount">@Money.Signed(entry.Amount, entry.IsIn, _monthData.CurrencyCode)</MudText>
                                </div>
                            }
                        </div>
                    </MudPaper>
                }
            }
        }
        else
        {
            @if (_days is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (SelectedDays is not { } account)
            {
                <MudPaper Class="pa-6 text-center" Elevation="0" Outlined="true" data-testid="cash-flow-empty">
                    <MudText Typo="Typo.body1">Nothing goes in or out @(_month ? "this month" : "this week").</MudText>
                </MudPaper>
            }
            else
            {
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <div class="d-flex align-center flex-wrap gap-2">
                        <MudText Typo="Typo.body2" Class="flex-grow-1" data-testid="day-totals">
                            In @Format(account.TotalIn, _days.CurrencyCode) · Out @Format(account.TotalOut, _days.CurrencyCode)
                        </MudText>
                        @* Where the account stands at the end of the period, counting from its month's start (BUD-136). *@
                        @Net(account.Days.LastOrDefault()?.RunningTotal ?? account.BroughtForward, _days.CurrencyCode)
                    </div>
                    @if (account.Days.FirstOrDefault(d => d.IsShort) is { } firstShort)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="timing-gap">
                            More goes out than has come in by @IncomeDates.Format(firstShort.Date). Money will need to be in the account before then.
                        </MudAlert>
                    }
                    @if (account is { Suggestion: { } suggestion, AccountId: { } accountId } && _canEdit)
                    {
                        @* Short only until regular money arrives: offer to start the account's month with it (BUD-136). *@
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" data-testid="month-start-tip">
                            <div>@suggestion.Name arrives on @suggestion.Date.ToString("d MMM", Display). If that's when this account gets its money for the month, start its month then, so it isn't shown short before it arrives.</div>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-1"
                                       OnClick="() => StartMonthWithAsync(accountId, suggestion.PaymentId)" data-testid="use-month-start">Start its month with @suggestion.Name</MudButton>
                        </MudAlert>
                    }
                </MudPaper>

                @if (account.BroughtForwardSince is { } since)
                {
                    @* The period starts part-way through the account's month: the running totals carry on from here (BUD-136). *@
                    <div class="d-flex align-center gap-2 mb-3 pr-3 mud-typography mud-typography-subtitle2" data-testid="brought-forward">
                        <span class="flex-grow-1">Brought forward since @since.ToString("d MMM", Display)</span>
                        <strong class="text-nowrap">@Format(account.BroughtForward, _days.CurrencyCode)</strong>
                    </div>
                }

                @foreach (var day in account.Days)
                {
                    @if (day.MonthStarted is { } started)
                    {
                        <div class="month-start" data-testid="month-start">@MonthStartLabel(account, day, started)</div>
                    }
                    <section class="mb-3" data-testid="cash-flow-day" aria-label="@day.Date.ToString("dddd d MMMM", Display)">
                        @* The day's total lines up with the amounts in the panel below: wording on the left, amount on the right (BUD-135). *@
                        <h2 class="mud-typography mud-typography-subtitle2 d-flex align-center gap-2 mb-1 pr-3">
                            <span class="flex-grow-1" style="font-weight: 600" data-testid="day-name">@day.Date.ToString("ddd d MMM", Display)</span>
                            @if (day.IsShort)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" aria-hidden="true" />
                                <span class="text-nowrap" data-testid="day-short">Short by <strong>@Format(-day.RunningTotal, _days.CurrencyCode)</strong></span>
                            }
                            else
                            {
                                <span class="text-nowrap" data-testid="day-running">Running total <strong>@Format(day.RunningTotal, _days.CurrencyCode)</strong></span>
                            }
                        </h2>
                        <MudPaper Outlined="true" Class="px-3 py-1">
                            @foreach (var entry in day.Entries)
                            {
                                <div class="d-flex align-center gap-2 py-1" data-testid="cash-flow-line">
                                    <MudIcon Icon="@(entry.IsIn ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small"
                                             Color="@(entry.IsIn ? Color.Success : Color.Default)" aria-hidden="true" />
                                    <MudLink Href="@Link(entry)" Typo="Typo.body2" Class="flex-grow-1" data-testid="line-name">@Label(entry)</MudLink>
                                    <MudText Typo="Typo.body2" Class="text-nowrap" data-testid="line-amount">@Money.Signed(entry.Amount, entry.IsIn, _days.CurrencyCode)</MudText>
                                </div>
                            }
                        </MudPaper>
                    </section>
                }
            }
        }
    }
</MudContainer>

@code {
    private static readonly CultureInfo Display = CultureInfo.InvariantCulture;

    private HouseholdMembershipSummary? _household;
    private bool _loaded;
    private bool _daily;
    private bool _month = true;
    private DayOfWeek _firstDay = DayOfWeek.Sunday;
    private DateOnly _from;
    private DateOnly _to;
    private Guid? _account;
    private CashFlowMonthResponse? _monthData;
    private CashFlowDaysResponse? _days;
    private bool _canEdit;

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    /// <summary>The monthly view, or day by day over a month: both move a month at a time.</summary>
    private bool Monthly => !_daily || _month;

    private IReadOnlyList<PeriodChoice> WeekOrMonth =>
        [new("Week view", "show-week", !_month, EventCallback.Factory.Create(this, () => SetMonthAsync(false))), new("Month view", "show-month", _month, EventCallback.Factory.Create(this, () => SetMonthAsync(true)))];

    private string PeriodName => Monthly ? PeriodNames.Month(_from.Year, _from.Month) : PeriodNames.Days(_from, _to);

    private CashFlowDaysAccount? SelectedDays =>
        _days?.Accounts.FirstOrDefault(a => a.AccountId == _account) ?? _days?.Accounts.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        _firstDay = (await Settings.GetAsync()).FirstDayOfWeek;
        (_from, _to) = PaymentPeriods.MonthOf(Today);
        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_household is not { TransfersEnabled: true } household)
        {
            return;
        }

        if (_daily)
        {
            _days = await CashFlowApi.GetDaysAsync(household.HouseholdId, _from, _to);
            if (_days.Accounts.All(a => a.AccountId != _account))
            {
                _account = _days.Accounts.FirstOrDefault()?.AccountId;
            }
        }
        else
        {
            _monthData = await CashFlowApi.GetMonthAsync(household.HouseholdId, _from.Year, _from.Month);
        }
    }

    private async Task SetDailyAsync(bool daily)
    {
        if (daily == _daily)
        {
            return;
        }

        _daily = daily;
        (_from, _to) = PaymentPeriods.MonthOf(_from);
        _month = true;
        await LoadAsync();
    }

    private async Task SetMonthAsync(bool month)
    {
        if (month == _month)
        {
            return;
        }

        _month = month;
        var anchor = month ? _from : (_from <= Today && Today <= _to ? Today : _from);
        (_from, _to) = month ? PaymentPeriods.MonthOf(anchor) : PaymentPeriods.WeekOf(anchor, _firstDay);
        await LoadAsync();
    }

    private async Task GoToTodayAsync()
    {
        (_from, _to) = Monthly ? PaymentPeriods.MonthOf(Today) : PaymentPeriods.WeekOf(Today, _firstDay);
        await LoadAsync();
    }

    private async Task MoveAsync(int step)
    {
        (_from, _to) = Monthly ? PaymentPeriods.MonthOf(_from.AddMonths(step)) : PaymentPeriods.WeekOf(_from.AddDays(7 * step), _firstDay);
        await LoadAsync();
    }

    private static string Format(decimal amount, string currency) => Money.Format(amount, currency);

    /// <summary>e.g. "Month starts · Salary", or "Month starts · 1 Dec" when nothing happened that day.</summary>
    private static string MonthStartLabel(CashFlowDaysAccount account, CashFlowDay day, DateOnly started) =>
        string.Join(" · ", new[] { "Month starts", account.MonthStartsWith, started == day.Date ? null : started.ToString("d MMM", Display) }.OfType<string>());

    private async Task StartMonthWithAsync(Guid accountId, Guid paymentId)
    {
        if (_household is not null && await CashFlowApi.SetMonthStartAsync(_household.HouseholdId, accountId, paymentId))
        {
            await LoadAsync();
        }
    }

    /// <summary>e.g. "Mortgage · Bills pot".</summary>
    private static string Label(CashFlowEntry entry) => entry.Pot is { } pot ? $"{entry.Name} · {pot} pot" : entry.Name;

    private static string Link(CashFlowEntry entry) => BackLink.To(entry.Kind switch
    {
        CashFlowKindDto.Income => $"/income/{entry.Id}",
        CashFlowKindDto.Outgoing or CashFlowKindDto.SavingsIn => $"/outgoings/{entry.Id}",
        _ => $"/transfers/{entry.Id}",
    }, "/cash-flow");

    /// <summary>A surplus or shortfall, in words and with an icon, not colour alone.</summary>
    private RenderFragment Net(decimal net, string currency) =>
        @<span class="d-inline-flex align-center gap-1" data-testid="account-net">
            @if (net < 0m)
            {
                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" aria-hidden="true" />
                <MudText Typo="Typo.body1" Class="text-nowrap">Short by <strong>@Format(-net, currency)</strong></MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" aria-hidden="true" />
                <MudText Typo="Typo.body1" Class="text-nowrap">Surplus <strong>@Format(net, currency)</strong></MudText>
            }
        </span>;
}
