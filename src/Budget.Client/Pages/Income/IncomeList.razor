@page "/income"
@attribute [Authorize]
@using Budget.Client.Income
@using Budget.Shared.Income
@inject UserSession Session
@inject IIncomeApi IncomeApi
@inject TimeProvider Clock

<PageTitle>Income · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 mb-16">
    <div class="d-flex align-center flex-wrap gap-2 mb-2">
        <h1 class="mud-typography mud-typography-h4 flex-grow-1">Income</h1>
        @if (_canEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/income/new" data-testid="add-income">
                Add income
            </MudButton>
        }
    </div>

    <div class="d-flex align-center justify-space-between mb-3">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous month" OnClick="() => MoveAsync(-1)" data-testid="previous-month" />
        <MudText Typo="Typo.h6" data-testid="month-name">@IncomeDates.MonthName(_year, _month)</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next month" OnClick="() => MoveAsync(1)" data-testid="next-month" />
    </div>

    @if (_household is null && _loaded)
    {
        <MudAlert Severity="Severity.Info">You're not in a household yet.</MudAlert>
    }
    else if (_data is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudText Typo="Typo.overline">Take-home income this month</MudText>
            <MudText Typo="Typo.h4" data-testid="month-total">@Money.Format(_data.Total, _data.CurrencyCode)</MudText>
        </MudPaper>

        <MudSwitch T="bool" Value="_all" ValueChanged="ToggleAllAsync" Color="Color.Primary" Label="Show income that hasn't started or has ended" />

        @if (_data.Items.Count == 0)
        {
            <MudPaper Class="pa-6 mt-2 text-center" Elevation="0" Outlined="true" data-testid="income-empty">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="mt-2">No income this month</MudText>
                <MudText Typo="Typo.body2">
                    @(_canEdit ? "Add each income with its monthly take-home amount to see what you have to budget." : "Nobody has added any income for this month.")
                </MudText>
            </MudPaper>
        }

        @foreach (var item in _data.Items)
        {
            <MudCard Class="mt-3" Outlined="true" data-testid="income-item">
                <MudCardContent>
                    <div class="d-flex align-start gap-2">
                        <div class="flex-grow-1" style="min-width: 0">
                            <MudLink Href="@($"/income/{item.Id}")" Typo="Typo.h6" data-testid="income-name">@item.Name</MudLink>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@item.PersonName</MudText>
                        </div>
                        <div class="text-right">
                            <MudText Typo="Typo.h6" data-testid="income-amount">@Money.Format(item.AmountForMonth, _data.CurrencyCode)</MudText>
                            @if (item.UsualAmount is { } usual && usual != item.AmountForMonth)
                            {
                                <MudText Typo="Typo.caption" data-testid="income-usual">usually @Money.Format(usual, _data.CurrencyCode)</MudText>
                            }
                        </div>
                    </div>
                    @foreach (var note in item.Notes)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-1" data-testid="income-note">@note</MudText>
                    }
                </MudCardContent>
            </MudCard>
        }
    }
</MudContainer>

@code {
    private HouseholdMembershipSummary? _household;
    private IncomeMonthResponse? _data;
    private bool _canEdit;
    private bool _all;
    private bool _loaded;
    private int _year;
    private int _month;

    protected override async Task OnInitializedAsync()
    {
        var today = Clock.GetLocalNow();
        (_year, _month) = (today.Year, today.Month);

        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_household is not null)
        {
            _data = await IncomeApi.GetMonthAsync(_household.HouseholdId, _year, _month, _all);
        }
    }

    private async Task MoveAsync(int months)
    {
        var next = new DateOnly(_year, _month, 1).AddMonths(months);
        (_year, _month) = (next.Year, next.Month);
        await LoadAsync();
    }

    private async Task ToggleAllAsync(bool value)
    {
        _all = value;
        await LoadAsync();
    }
}
