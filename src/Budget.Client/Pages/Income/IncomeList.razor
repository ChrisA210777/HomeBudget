@page "/income"
@attribute [Authorize]
@using Budget.Client.Accounts
@using Budget.Client.Income
@using Budget.Shared.Account
@using Budget.Shared.Accounts
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@inject UserSession Session
@inject IIncomeApi IncomeApi
@inject IAccountsApi AccountsApi
@inject TimeProvider Clock
@inject UserSettingsStore Settings

<PageTitle>Income · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2 mb-16">
    @* The same layout as Outgoings: the title and action stay at the top while the list scrolls (BUD-79). *@
    <div class="list-head" data-testid="list-head">
        <div class="list-head-title d-flex align-center gap-2" data-testid="list-head-title">
            <h1 class="mud-typography mud-typography-h4 flex-grow-1 list-head-heading">Income</h1>
            @if (_canEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/income/new"
                           Class="icon-only-xs" aria-label="Add income" title="Add income" data-testid="add-income">
                    <span class="button-label">Add income</span>
                </MudButton>
            }
        </div>

        <div class="d-flex align-center justify-space-between mb-2">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="@(IsYear ? "Start a month earlier" : "Previous month")" OnClick="() => MoveAsync(-1)" data-testid="previous-month" />
            <MudText Typo="Typo.h6" data-testid="month-name">@PeriodName</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="@(IsYear ? "Start a month later" : "Next month")" OnClick="() => MoveAsync(1)" data-testid="next-month" />
        </div>

        @if (_data is not null)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <div class="d-flex align-center justify-space-between gap-2">
                    <MudText Typo="Typo.overline">Take-home income @(IsYear ? "over 12 months" : "this month")</MudText>
                    @* Month or year, as on Outgoings (BUD-80). *@
                    <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OverrideStyles="false" role="group" aria-label="Show amounts for" data-testid="period-toggle">
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(IsYear ? Variant.Outlined : Variant.Filled)" aria-pressed="@(IsYear ? "false" : "true")"
                                   OnClick="() => SetMonthsAsync(1)" data-testid="show-month">Month</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(IsYear ? Variant.Filled : Variant.Outlined)" aria-pressed="@(IsYear ? "true" : "false")"
                                   OnClick="() => SetMonthsAsync(12)" data-testid="show-year">Year</MudButton>
                    </MudButtonGroup>
                </div>
                <MudText Typo="Typo.h4" data-testid="month-total">@Money.Format(_data.Total, _data.CurrencyCode)</MudText>
            </MudPaper>
        }
    </div>

    @if (_household is null && _loaded)
    {
        <MudAlert Severity="Severity.Info">You're not in a household yet.</MudAlert>
    }
    else if (_data is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        @if (_data.Items.Count == 0)
        {
            <MudPaper Class="pa-6 mt-2 text-center" Elevation="0" Outlined="true" data-testid="income-empty">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="mt-2">No income this month</MudText>
                <MudText Typo="Typo.body2">
                    @(_canEdit ? "Add each income with the amount you receive and how often, to see what you have to budget." : "Nobody has added any income for this month.")
                </MudText>
            </MudPaper>
        }

        var groups = Groups(_data.Items).ToList();
        var grouped = groups.Count > 1;
        @foreach (var group in groups)
        {
            @if (grouped)
            {
                <h2 class="mud-typography mud-typography-subtitle1 d-flex align-center gap-2 mt-4 mb-0 category-heading" style="font-weight: 600" data-testid="paid-into-group">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Primary" aria-hidden="true" />
                    <span data-testid="paid-into-name">@group.Name</span>
                    <span class="flex-grow-1"></span>
                    <span style="font-weight: 400" data-testid="paid-into-total">@Money.Format(group.Items.Sum(i => i.AmountForMonth), _data.CurrencyCode)</span>
                </h2>
            }
        @foreach (var item in group.Items)
        {
            <MudCard Class="mt-3" Outlined="true" data-testid="income-item">
                <MudCardContent>
                    <div class="d-flex align-start gap-2">
                        <div class="flex-grow-1" style="min-width: 0">
                            <MudLink Href="@BackLink.To($"/income/{item.Id}", "/income")" Typo="Typo.h6" data-testid="income-name">@item.Name</MudLink>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" data-testid="income-person">@item.PersonName@(AccountOf(item).Pot is { } pot ? $" · {pot} pot" : !grouped && AccountOf(item).Name is { } account ? $" · into {account}" : string.Empty)</MudText>
                            @if (item.ReceivedAmount is { } received && !(item.Every == 1 && item.Unit == PaymentUnitDto.Month))
                            {
                                <MudText Typo="Typo.caption" Class="d-block" data-testid="income-received">
                                    @Money.Format(received, _data.CurrencyCode) @OutgoingValidator.DescribeSchedule(item.Every, item.Unit)
                                </MudText>
                            }
                        </div>
                        <div class="text-right">
                            <MudText Typo="Typo.h6" data-testid="income-amount">@Money.Format(item.AmountForMonth, _data.CurrencyCode)</MudText>
                            @if (IsYear)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="income-period">over 12 months</MudText>
                            }
                            else if (item.UsualAmount is { } usual && usual != item.AmountForMonth)
                            {
                                <MudText Typo="Typo.caption" data-testid="income-usual">usually @Money.Format(usual, _data.CurrencyCode)</MudText>
                            }
                        </div>
                    </div>
                    @foreach (var note in item.Notes)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-1" data-testid="income-note">@note</MudText>
                    }
                </MudCardContent>
            </MudCard>
        }
        }

        @* Income that hasn't started or has ended is out of the way, but a tap away (BUD-99). *@
        @if (_data.Inactive > 0)
        {
            <div class="d-flex align-center flex-wrap gap-2 mt-4" data-testid="inactive">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@InactiveText(_data.Inactive)</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => ToggleAllAsync(!_all)" data-testid="show-all">@(_all ? "Hide" : "Show")</MudButton>
            </div>
        }
    }
</MudContainer>

@code {
    private HouseholdMembershipSummary? _household;
    private IncomeMonthResponse? _data;
    private bool _canEdit;
    private bool _all;
    private bool _loaded;
    private int _year;
    private int _month;

    /// <summary>1 for a month, 12 for the 12 months starting with it (BUD-80).</summary>
    private int _months = 1;

    private bool IsYear => _months == 12;

    private IReadOnlyList<AccountSummary> _accounts = [];

    /// <summary>The account it's paid into, with a pot counted in its account (BUD-99).</summary>
    private (Guid? Id, string? Name, string? Pot) AccountOf(IncomeMonthItem item) => AccountLevel.Of(item.AccountId, item.PaidInto, _accounts);

    /// <summary>One group per account it's paid into, by name, with "Not set" last (BUD-90, BUD-99).</summary>
    private IEnumerable<(string Name, List<IncomeMonthItem> Items)> Groups(IReadOnlyList<IncomeMonthItem> items) => items
        .GroupBy(i => AccountOf(i) is { Id: { } id } ? id.ToString() : AccountOf(i).Name?.Trim().ToUpperInvariant() ?? string.Empty)
        .Select(g => (Name: g.Key.Length == 0 ? "Not set" : AccountOf(g.First()).Name ?? "Not set", Empty: g.Key.Length == 0, Items: g.ToList()))
        .OrderBy(g => g.Empty)
        .ThenBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase)
        .Select(g => (g.Name, g.Items));

    private static string InactiveText(int count) => count == 1 ? "1 income hasn't started yet or has ended." : $"{count} incomes haven't started yet or have ended.";

    private string PeriodName => IsYear
        ? $"{ShortMonth(new DateOnly(_year, _month, 1))} – {ShortMonth(new DateOnly(_year, _month, 1).AddMonths(11))}"
        : IncomeDates.MonthName(_year, _month);

    private static string ShortMonth(DateOnly date) => date.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var today = Clock.GetLocalNow();
        (_year, _month) = (today.Year, today.Month);

        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        _months = (await Settings.GetAsync()).IncomePeriod == ListPeriodDto.Year ? 12 : 1;
        if (_household is not null)
        {
            _accounts = await AccountsApi.ListAsync(_household.HouseholdId);
        }

        _loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_household is not null)
        {
            _data = await IncomeApi.GetMonthAsync(_household.HouseholdId, _year, _month, _all, _months);
        }
    }

    private async Task MoveAsync(int months)
    {
        var next = new DateOnly(_year, _month, 1).AddMonths(months);
        (_year, _month) = (next.Year, next.Month);
        await LoadAsync();
    }

    private async Task SetMonthsAsync(int months)
    {
        if (months != _months)
        {
            _months = months;
            await LoadAsync();
            await Settings.UpdateAsync(new UpdateUserSettingsRequest { IncomePeriod = IsYear ? ListPeriodDto.Year : ListPeriodDto.Month });
        }
    }

    private async Task ToggleAllAsync(bool value)
    {
        _all = value;
        await LoadAsync();
    }
}
