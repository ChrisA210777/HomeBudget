@page "/income/new"
@attribute [Authorize]
@using Budget.Client.Income
@using Budget.Client.Pages.Accounts
@using Budget.Client.People
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@using Budget.Shared.People
@inject UserSession Session
@inject IIncomeApi IncomeApi
@inject IPeopleApi PeopleApi
@inject NavigationManager Navigation
@inject TimeProvider Clock

<PageTitle>Add income · Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4 mb-16">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/income" Class="mb-2">Income</MudButton>
    <h1 class="mud-typography mud-typography-h4 mb-4">Add income</h1>

    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!_canEdit)
    {
        <MudAlert Severity="Severity.Info" data-testid="read-only">Viewers can see income but not add it.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_name" Label="Name" HelperText="@NameHelp" MaxLength="IncomeValidator.NameMaxLength"
                              Error="Has(nameof(CreateIncomeStreamRequest.Name))" ErrorText="@ErrorFor(nameof(CreateIncomeStreamRequest.Name))"
                              Variant="Variant.Outlined" data-testid="name" />

                <MudSelect T="Guid" @bind-Value="_personId" ToStringFunc="PersonName" Label="Whose income is it?"
                           Error="Has(nameof(CreateIncomeStreamRequest.PersonId))" ErrorText="@ErrorFor(nameof(CreateIncomeStreamRequest.PersonId))"
                           Variant="Variant.Outlined" data-testid="person">
                    @foreach (var person in _people)
                    {
                        <MudSelectItem T="Guid" Value="person.Id">@person.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption">Someone missing? <MudLink Href="/people">Add them on the People page</MudLink>.</MudText>

                <div class="d-flex gap-2 flex-wrap align-start">
                    <MudNumericField T="decimal?" @bind-Value="_amount" Format="F2" Label="Amount received" Immediate="true" HelperText="@IncomeValidator.AmountHelp"
                                     Adornment="Adornment.Start" AdornmentText="£" InputMode="@(InputMode.@decimal)" HideSpinButtons="true" Min="0"
                                     Error="Has(nameof(CreateIncomeStreamRequest.Amount))" ErrorText="@ErrorFor(nameof(CreateIncomeStreamRequest.Amount))"
                                     Variant="Variant.Outlined" Class="flex-grow-1" Style="min-width: 9rem" data-testid="amount" />
                    <div class="d-flex gap-2">
                        <div style="width: 5.5rem">
                            <MudNumericField T="int" @bind-Value="_every" Class="every-field" Label="Every" Immediate="true" Min="1" Max="OutgoingValidator.MaxEvery"
                                             InputMode="InputMode.numeric" HideSpinButtons="true"
                                             Error="Has(nameof(CreateIncomeStreamRequest.Every))" ErrorText="@ErrorFor(nameof(CreateIncomeStreamRequest.Every))"
                                             Variant="Variant.Outlined" data-testid="every" />
                        </div>
                        <div style="width: 8rem">
                            <MudSelect T="PaymentUnitDto" @bind-Value="_unit" ToStringFunc="UnitName" Label="Period" Variant="Variant.Outlined" data-testid="unit">
                                @foreach (var unit in Enum.GetValues<PaymentUnitDto>())
                                {
                                    <MudSelectItem T="PaymentUnitDto" Value="unit">@UnitName(unit)</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>
                </div>
                @if (OutgoingValidator.DescribeMonthlyEquivalent(_amount, _every, _unit) is { } equivalent)
                {
                    <MudText Typo="Typo.body2" Color="Color.Primary" aria-live="polite" data-testid="monthly-equivalent">@equivalent</MudText>
                }

                <MudDatePicker @bind-Date="_startsOn" Label="First payment" DateFormat="d MMM yyyy"
                               Error="Has(nameof(CreateIncomeStreamRequest.StartsOn))" ErrorText="@ErrorFor(nameof(CreateIncomeStreamRequest.StartsOn))"
                               Variant="Variant.Outlined" data-testid="starts-on" />

                <AccountPicker HouseholdId="@(_household?.HouseholdId ?? Guid.Empty)" @bind-Value="_paidInto" Label="Paid into (optional)"
                               HelperText="The account or pot it lands in, e.g. “Chris current”" TestId="paid-into" />

                <div class="d-flex justify-end gap-2 mt-2">
                    <MudButton Variant="Variant.Text" Href="/income">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_saving || !Online)" data-testid="save">Add income</MudButton>
                </div>
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    /// <summary>False while the device is offline, when changes can't be saved (BUD-38).</summary>
    [CascadingParameter(Name = "Online")]
    public bool Online { get; set; } = true;

    private const string NameHelp = "For example, “Chris – salary”";

    private HouseholdMembershipSummary? _household;
    private IReadOnlyList<PersonSummary> _people = [];
    private string? _paidInto;
    private IReadOnlyDictionary<string, string[]> _errors = new Dictionary<string, string[]>();
    private bool _loaded;
    private bool _canEdit;
    private bool _saving;

    private string? _name;
    private Guid _personId;
    private decimal? _amount;
    private int _every = 1;
    private PaymentUnitDto _unit = PaymentUnitDto.Month;
    private DateTime? _startsOn;

    protected override async Task OnInitializedAsync()
    {
        var today = Clock.GetLocalNow();
        _startsOn = new DateTime(today.Year, today.Month, 1, 0, 0, 0, DateTimeKind.Unspecified);

        _household = await Session.GetActiveHouseholdAsync();
        _canEdit = _household is not null && _household.Role != "Viewer";
        if (_household is not null)
        {
            _people = await PeopleApi.ListAsync(_household.HouseholdId);
            _personId = _household.PersonId ?? _people.FirstOrDefault()?.Id ?? Guid.Empty;
        }

        _loaded = true;
    }

    private async Task SaveAsync()
    {
        var request = new CreateIncomeStreamRequest
        {
            Name = _name ?? string.Empty,
            PersonId = _personId,
            PaidInto = _paidInto,
            Amount = _amount,
            Every = _every,
            Unit = _unit,
            StartsOn = IncomeDates.ToDateOnly(_startsOn),
        };

        _errors = IncomeValidator.Validate(request);
        if (_errors.Count > 0)
        {
            return;
        }

        _saving = true;
        try
        {
            var result = await IncomeApi.CreateAsync(_household!.HouseholdId, request);
            if (result.Succeeded)
            {
                Navigation.NavigateTo($"/income/{result.Value!.Id}");
                return;
            }

            _errors = result.Errors;
        }
        finally
        {
            _saving = false;
        }
    }

    private string UnitName(PaymentUnitDto unit)
    {
        var word = unit.ToString().ToLowerInvariant();
        return _every == 1 ? word : word + "s";
    }

    private string PersonName(Guid id) => _people.FirstOrDefault(p => p.Id == id)?.DisplayName ?? string.Empty;

    private bool Has(string field) => _errors.ContainsKey(field);

    private string? ErrorFor(string field) => _errors.TryGetValue(field, out var messages) ? string.Join(" ", messages) : null;
}
