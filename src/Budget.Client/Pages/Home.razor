@page "/"
@attribute [Authorize]
@using Budget.Client.Budgeting
@using Budget.Client.Households
@using Budget.Client.Outgoings
@using Budget.Shared.Budgeting
@using Budget.Shared.Households
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@inject UserSession Session
@inject IHouseholdApi HouseholdApi
@inject IBudgetApi BudgetApi
@inject IRenewalApi RenewalApi

<PageTitle>Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6 mb-16">
    @if (_renaming)
    {
        <div class="d-flex align-start gap-1 mb-1" data-testid="rename-form">
            <MudTextField @bind-Value="_newName" Label="Household name" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true"
                          MaxLength="HouseholdValidator.NameMaxLength" Immediate="true" OnKeyDown="OnRenameKeyDownAsync"
                          Error="_error is not null" ErrorText="@_error" Class="flex-grow-1" data-testid="rename-input" />
            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" aria-label="Save name" OnClick="SaveNameAsync" Disabled="@(_saving || !Online)" Class="mt-1" data-testid="rename-save" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Cancel rename" OnClick="CancelRename" Class="mt-1" data-testid="rename-cancel" />
        </div>
    }
    else
    {
        <div class="d-flex align-center gap-1">
            <h1 class="mud-typography mud-typography-h4">@(_household?.Name ?? "Home Budget")</h1>
            @if (_household?.Role == "Admin")
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Rename household" OnClick="StartRename" data-testid="rename-household" />
            }
        </div>
    }

    @if (_notice is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _notice = null" data-testid="rename-conflict">@_notice</MudAlert>
    }

    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.h6" Class="mb-2" data-testid="welcome">Welcome, @context.User.Identity?.Name</MudText>
        </Authorized>
    </AuthorizeView>

    @if (_household is not null)
    {
        <MudText Typo="Typo.body2" Class="mb-4" data-testid="household-role">
            @(_household.IsOwner ? "You're the owner of this household." : $"Your role in this household: {_household.Role}.")
        </MudText>
    }

    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudCard Outlined="true" data-testid="budget-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Class="mr-1" />Budget this month</MudText>
                    @if (_budget is null)
                    {
                        <MudText Typo="Typo.body2">What's left after all your outgoings.</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="d-block">Left after everything</MudText>
                        @if (_budget.LeftAfterEverything < 0)
                        {
                            <MudText Typo="Typo.h5" Class="budget-shortfall" data-testid="home-left">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" aria-hidden="true" />Short by @Money.Format(-_budget.LeftAfterEverything, _budget.CurrencyCode)
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.h5" data-testid="home-left">@Money.Format(_budget.LeftAfterEverything, _budget.CurrencyCode)</MudText>
                        }
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @Money.Format(_budget.Income, _budget.CurrencyCode) in, @Money.Format(_budget.Outgoings, _budget.CurrencyCode) out
                        </MudText>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/budget" Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" data-testid="go-to-budget">Go to budget</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        @if (_renewals is { Count: > 0 })
        {
            <MudItem xs="12">
                <MudCard Outlined="true" data-testid="coming-up-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.EventRepeat" Size="Size.Small" Class="mr-1" />Coming up</MudText>
                        <ul class="plain-list" aria-label="Renewals coming up">
                            @foreach (var renewal in _renewals)
                            {
                                <li class="py-2" data-testid="coming-up">
                                    <div class="d-flex align-start gap-2">
                                        <div class="flex-grow-1" style="min-width: 0">
                                            <MudLink Href="@($"/outgoings/{renewal.Id}")" Typo="Typo.body1" data-testid="coming-up-name">@renewal.Name</MudLink>
                                            <MudText Typo="Typo.body2" data-testid="coming-up-text">@OutgoingValidator.DescribeRenewal(renewal.Name, renewal.RenewalDate, renewal.AutoRenews)</MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ma-0" data-testid="coming-up-days">@OutgoingValidator.RenewsIn(renewal.DaysUntil)</MudChip>
                                    </div>
                                </li>
                            }
                        </ul>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
        <MudItem xs="12" sm="6">
            <MudCard Outlined="true" Style="height: 100%" data-testid="income-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Class="mr-1" />Income</MudText>
                    <MudText Typo="Typo.body2">See what comes in each month, and record pay changes and leave.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/income" Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" data-testid="go-to-income">Go to income</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudCard Outlined="true" Style="height: 100%" data-testid="people-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" />People</MudText>
                    <MudText Typo="Typo.body2">Everyone in the household, including those who don't sign in.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="/people" Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" data-testid="go-to-people">Go to people</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudCard Outlined="true" Style="height: 100%" data-testid="outgoings-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" Class="mr-1" />Outgoings</MudText>
                    <MudText Typo="Typo.body2">Bills, savings and spending allowances, and the categories they go in.</MudText>
                </MudCardContent>
                <MudCardActions Class="flex-wrap">
                    @if (_household?.Role is not null and not "Viewer")
                    {
                        <MudButton Href="/outgoings/new" Color="Color.Primary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" data-testid="add-outgoing">Add an outgoing</MudButton>
                    }
                    <MudButton Href="/outgoings/categories" Color="Color.Primary" Variant="Variant.Text" data-testid="go-to-categories">Categories</MudButton>
                    <MudButton Href="/outgoings" Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" data-testid="go-to-outgoings">Go to outgoings</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    /// <summary>False while the device is offline, when changes can't be saved (BUD-38).</summary>
    [CascadingParameter(Name = "Online")]
    public bool Online { get; set; } = true;

    private HouseholdMembershipSummary? _household;
    private bool _renaming;
    private bool _saving;
    private string? _newName;
    private string? _error;
    private string? _notice;

    private BudgetMonthResponse? _budget;
    private IReadOnlyList<RenewalComingUp>? _renewals;

    protected override async Task OnInitializedAsync()
    {
        _household = await Session.GetActiveHouseholdAsync();
        if (_household is not null)
        {
            var budget = BudgetApi.GetMonthAsync(_household.HouseholdId);
            var renewals = RenewalApi.ComingUpAsync(_household.HouseholdId);
            _budget = await budget;
            _renewals = await renewals;
        }
    }

    private void StartRename()
    {
        _newName = _household!.Name;
        _error = null;
        _notice = null;
        _renaming = true;
    }

    private void CancelRename()
    {
        _renaming = false;
        _error = null;
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveNameAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task SaveNameAsync()
    {
        if (_saving || !Online)
        {
            return;
        }

        var request = new RenameHouseholdRequest { Name = _newName ?? string.Empty, PreviousName = _household!.Name };
        if (HouseholdValidator.Validate(request).TryGetValue(nameof(request.Name), out var messages))
        {
            _error = messages[0];
            return;
        }

        if (request.Name.Trim() == _household.Name)
        {
            CancelRename();
            return;
        }

        _saving = true;
        try
        {
            var result = await HouseholdApi.RenameAsync(_household.HouseholdId, request);
            if (result.Succeeded)
            {
                await ShowNameAsync(result.Household!.Name);
                _renaming = false;
            }
            else if (result.Conflict)
            {
                await ShowNameAsync(result.CurrentName!);
                _notice = $"Someone else has just renamed the household to “{result.CurrentName}”. Try again if you still want to change it.";
                _renaming = false;
            }
            else
            {
                _error = result.Errors.TryGetValue(nameof(request.Name), out var errors) ? errors[0] : "The name couldn't be saved.";
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowNameAsync(string name)
    {
        await Session.SetHouseholdNameAsync(_household!.HouseholdId, name);
        _household = _household with { Name = name };
    }
}
