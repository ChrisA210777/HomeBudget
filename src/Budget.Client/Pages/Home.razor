@page "/"
@attribute [Authorize]
@using Budget.Client.Budgeting
@using Budget.Client.Households
@using Budget.Client.Outgoings
@using Budget.Shared.Budgeting
@using Budget.Shared.Households
@using Budget.Shared.Income
@using Budget.Shared.Outgoings
@inject UserSession Session
@inject IHouseholdApi HouseholdApi
@inject IBudgetApi BudgetApi
@inject IRenewalApi RenewalApi
@inject IJSRuntime JS

<PageTitle>Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6 mb-16">
    @if (_renaming)
    {
        <div class="d-flex align-start gap-1 mb-1" data-testid="rename-form">
            <MudTextField @bind-Value="_newName" Label="Household name" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true"
                          MaxLength="HouseholdValidator.NameMaxLength" Immediate="true" OnKeyDown="OnRenameKeyDownAsync"
                          Error="_error is not null" ErrorText="@_error" Class="flex-grow-1" data-testid="rename-input" />
            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" aria-label="Save name" OnClick="SaveNameAsync" Disabled="@(_saving || !Online)" Class="mt-1" data-testid="rename-save" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Cancel rename" OnClick="CancelRename" Class="mt-1" data-testid="rename-cancel" />
        </div>
    }
    else
    {
        <div class="d-flex align-center gap-1">
            <h1 class="mud-typography mud-typography-h4">@(_household?.Name ?? "Home Budget")</h1>
            @if (_household?.Role == "Admin")
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Rename household" OnClick="StartRename" data-testid="rename-household" />
            }
        </div>
    }

    @if (Imported == true && !_importedDismissed && _household is not null)
    {
        <MudAlert Severity="Severity.Success" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _importedDismissed = true" data-testid="imported">
            Your data was imported into @_household.Name. If other people used it before, they'll need inviting again.
        </MudAlert>
    }

    @if (Replaced == true && !_importedDismissed && _household is not null)
    {
        <MudAlert Severity="Severity.Success" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _importedDismissed = true" data-testid="replaced">
            @_household.Name's data was replaced from the file.
        </MudAlert>
    }

    @if (_notice is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _notice = null" data-testid="rename-conflict">@_notice</MudAlert>
    }

    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.h6" Class="mb-2" data-testid="welcome">Welcome, @(_household?.PersonName ?? context.User.Identity?.Name)</MudText>
        </Authorized>
    </AuthorizeView>

    @if (_household is not null)
    {
        <MudText Typo="Typo.body2" Class="mb-4" data-testid="household-role">
            @(_household.IsOwner ? "You're the owner of this household." : $"Your role in this household: {_household.Role}.")
        </MudText>
    }

    @if (_loaded && _household is null)
    {
        <MudCard Outlined="true" data-testid="no-household">
            <MudCardContent>
                <MudText Typo="Typo.h6">You're not in a household</MudText>
                <MudText Typo="Typo.body2">Create one to start budgeting, or ask someone to invite you to theirs.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="/households/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddHome" data-testid="no-household-create">Create household</MudButton>
            </MudCardActions>
        </MudCard>
    }
    else
    {
        <MudGrid Spacing="2">
            @if (Steps.Count > 0)
            {
                <MudItem xs="12">
                    <MudCard Outlined="true" Class="getting-started" data-testid="getting-started">
                        <MudCardContent>
                            <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" aria-hidden="true" />Getting started</MudText>
                            <ul class="plain-list" aria-label="Next steps">
                                @foreach (var step in Steps)
                                {
                                    <li class="py-2" data-testid="@($"setup-{step.Id}")">
                                        <div class="d-flex align-center gap-2 flex-wrap">
                                            <MudIcon Icon="@step.Icon" Color="Color.Primary" aria-hidden="true" />
                                            <div class="flex-grow-1" style="min-width: 12rem">
                                                <MudText Typo="Typo.body1"><strong>@step.Title</strong></MudText>
                                                <MudText Typo="Typo.body2">@step.Text</MudText>
                                            </div>
                                            <MudButton Href="@(step.Href.EndsWith("/new", StringComparison.Ordinal) ? BackLink.To(step.Href, "/") : step.Href)" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" data-testid="@($"setup-{step.Id}-go")">@step.Action</MudButton>
                                            @if (step.Id == PeopleStep)
                                            {
                                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="NotNowAsync" data-testid="setup-people-not-now">Not now</MudButton>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
            <MudItem xs="12">
                <MudCard Outlined="true" data-testid="budget-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Class="mr-1" />Budget this month</MudText>
                        @if (_budget is null)
                        {
                            <MudText Typo="Typo.body2">What's left after all your outgoings.</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="d-block">Left over</MudText>
                            @if (_budget.LeftAfterEverything < 0)
                            {
                                <MudText Typo="Typo.h5" Class="budget-shortfall" data-testid="home-left">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" aria-hidden="true" />Short by @Money.Format(-_budget.LeftAfterEverything, _budget.CurrencyCode)
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.h5" data-testid="home-left">@Money.Format(_budget.LeftAfterEverything, _budget.CurrencyCode)</MudText>
                            }
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Money.Format(_budget.Income, _budget.CurrencyCode) in, @Money.Format(_budget.Outgoings, _budget.CurrencyCode) out
                            </MudText>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="/budget" Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" data-testid="go-to-budget">Go to budget</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            @if (_renewals is { Count: > 0 })
            {
                <MudItem xs="12">
                    <MudCard Outlined="true" data-testid="coming-up-card">
                        <MudCardContent>
                            <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.EventRepeat" Size="Size.Small" Class="mr-1" />Coming up</MudText>
                            <ul class="plain-list" aria-label="Renewals coming up">
                                @foreach (var renewal in _renewals)
                                {
                                    <li class="py-2" data-testid="coming-up">
                                        @* Phones: name and chip on one line, what to do full width under them (BUD-123). Larger
                                           screens: name and what to do on the left, the chip on the right (BUD-129). *@
                                        <div class="coming-up-row">
                                            <MudLink Href="@BackLink.To($"/outgoings/{renewal.Id}", "/")" Typo="Typo.body1" Class="coming-up-name" data-testid="coming-up-name">@renewal.Name</MudLink>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ma-0 coming-up-days" data-testid="coming-up-days">@OutgoingValidator.RenewsIn(renewal.DaysUntil)</MudChip>
                                            <MudText Typo="Typo.body2" Class="coming-up-text" data-testid="coming-up-text">@OutgoingValidator.DescribeRenewal(renewal.RenewalDate, renewal.AutoRenews)</MudText>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="/outgoings/renewals" Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" data-testid="go-to-renewals">All renewals</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    /// <summary>False while the device is offline, when changes can't be saved (BUD-38).</summary>
    [CascadingParameter(Name = "Online")]
    public bool Online { get; set; } = true;

    /// <summary>Set after importing a file as a new household (BUD-63), to say it worked.</summary>
    [SupplyParameterFromQuery(Name = "imported")]
    public bool? Imported { get; set; }

    /// <summary>Set after replacing the household's data from a file (BUD-62), to say it worked.</summary>
    [SupplyParameterFromQuery(Name = "replaced")]
    public bool? Replaced { get; set; }

    private bool _importedDismissed;

    private HouseholdMembershipSummary? _household;
    private bool _loaded;
    private bool _renaming;
    private bool _saving;
    private string? _newName;
    private string? _error;
    private string? _notice;

    private const string PeopleStep = "add-people";
    private const string PeopleStepDismissedKey = "budget.setup.people.dismissed";

    private HouseholdSetupResponse? _setup;
    private bool _peopleStepDismissed;
    private BudgetMonthResponse? _budget;
    private IReadOnlyList<RenewalComingUp>? _renewals;

    protected override async Task OnInitializedAsync()
    {
        _household = await Session.GetActiveHouseholdAsync();
        if (_household is not null)
        {
            var budget = BudgetApi.GetMonthAsync(_household.HouseholdId);
            var renewals = RenewalApi.ComingUpAsync(_household.HouseholdId);
            var setup = _household.Role == "Viewer" ? null : HouseholdApi.GetSetupAsync(_household.HouseholdId);
            _peopleStepDismissed = await IsPeopleStepDismissedAsync();
            _budget = await budget;
            _renewals = await renewals;
            _setup = setup is null ? null : await setup;
        }

        _loaded = true;
    }

    private sealed record SetupStep(string Id, string Icon, string Title, string Text, string Action, string Href);

    /// <summary>The getting-started steps not done yet, in order (BUD-68). Viewers can't add anything, so they get none.</summary>
    private List<SetupStep> Steps
    {
        get
        {
            var steps = new List<SetupStep>();
            if (_setup is null)
            {
                return steps;
            }

            if (_setup.People <= 1 && !_peopleStepDismissed)
            {
                steps.Add(new(PeopleStep, Icons.Material.Filled.People, "Add the people in your household",
                    "Partners or children, so income and outgoings can be theirs. They don't need to sign in.", "Add people", "/people"));
            }

            if (_setup.Incomes == 0)
            {
                steps.Add(new("add-income", Icons.Material.Filled.Payments, "Add your income",
                    "What comes in each month, after tax and other deductions.", "Add income", "/income/new"));
            }

            if (_setup.Outgoings == 0)
            {
                steps.Add(new("add-outgoing", Icons.Material.Filled.ReceiptLong, "Add your outgoings",
                    "Bills, savings and spending allowances, so you can see what's left.", "Add an outgoing", "/outgoings/new"));
            }

            return steps;
        }
    }

    // Remembered on this device only, so it's a light touch: some households are one person.
    private async Task<bool> IsPeopleStepDismissedAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", $"{PeopleStepDismissedKey}.{_household!.HouseholdId}") == "true";
        }
        catch (JSException)
        {
            return false;
        }
    }

    private async Task NotNowAsync()
    {
        _peopleStepDismissed = true;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", $"{PeopleStepDismissedKey}.{_household!.HouseholdId}", "true");
        }
        catch (JSException)
        {
            // Not saved (e.g. private browsing): it's hidden until the page is reloaded.
        }
    }

    private void StartRename()
    {
        _newName = _household!.Name;
        _error = null;
        _notice = null;
        _renaming = true;
    }

    private void CancelRename()
    {
        _renaming = false;
        _error = null;
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveNameAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task SaveNameAsync()
    {
        if (_saving || !Online)
        {
            return;
        }

        var request = new RenameHouseholdRequest { Name = _newName ?? string.Empty, PreviousName = _household!.Name };
        if (HouseholdValidator.Validate(request).TryGetValue(nameof(request.Name), out var messages))
        {
            _error = messages[0];
            return;
        }

        if (request.Name.Trim() == _household.Name)
        {
            CancelRename();
            return;
        }

        _saving = true;
        try
        {
            var result = await HouseholdApi.RenameAsync(_household.HouseholdId, request);
            if (result.Succeeded)
            {
                await ShowNameAsync(result.Household!.Name);
                _renaming = false;
            }
            else if (result.Conflict)
            {
                await ShowNameAsync(result.CurrentName!);
                _notice = $"Someone else has just renamed the household to “{result.CurrentName}”. Try again if you still want to change it.";
                _renaming = false;
            }
            else
            {
                _error = result.Errors.TryGetValue(nameof(request.Name), out var errors) ? errors[0] : "The name couldn't be saved.";
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowNameAsync(string name)
    {
        await Session.SetHouseholdNameAsync(_household!.HouseholdId, name);
        _household = _household with { Name = name };
    }
}
