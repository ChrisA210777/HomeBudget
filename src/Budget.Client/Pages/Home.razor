@page "/"
@attribute [Authorize]
@inject UserSession Session

<PageTitle>Home Budget</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <h1 class="mud-typography mud-typography-h4">@(_household?.Name ?? "Home Budget")</h1>
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.h6" Class="mb-2" data-testid="welcome">Welcome, @context.User.Identity?.Name</MudText>
        </Authorized>
    </AuthorizeView>

    @if (_household is not null)
    {
        <MudText Typo="Typo.body2" Class="mb-4" data-testid="household-role">
            @(_household.IsOwner ? "You're the owner of this household." : $"Your role in this household: {_household.Role}.")
        </MudText>
    }

    <MudCard Outlined="true" Class="mt-2">
        <MudCardContent>
            <MudText Typo="Typo.h6">Income</MudText>
            <MudText Typo="Typo.body2">Record each job in the household and see what comes in each month.</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Href="/income" Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" data-testid="go-to-income">Go to income</MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private HouseholdMembershipSummary? _household;

    protected override async Task OnInitializedAsync() => _household = await Session.GetActiveHouseholdAsync();
}
